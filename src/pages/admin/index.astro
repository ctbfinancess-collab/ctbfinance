      .editar { margin: 0.2rem 0 0.4rem; }
      .edicao { display: grid; gap: 0.8rem; margin: 0.4rem 0 0.6rem; }
      .edicao__grade { display: grid; grid-template-columns: 1fr 1fr; gap: 0.7rem 1rem; }
      .faixa h1 { margin: 0; font-size: clamp(1.5rem, 2.6vw, 2.2rem); font-weight: 600; }
      .faixa h1 em { font-style: normal; color: var(--ouro); }
      .faixa p { margin: 0.25rem 0 0; color: var(--texto); opacity: 0.85; font-size: 0.98rem; }
      .quem { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.6rem; margin: 1.4rem 0.2rem 0; padding: 0.8rem 0.85rem; border-radius: 12px; background: rgba(217, 174, 107, 0.07); border: 1px solid var(--borda); font-size: 0.82rem; }
      .quem [data-email] { flex: 1; min-width: 0; overflow-wrap: anywhere; }
      .quem > svg { color: var(--ouro); }
      .sair { display: flex; align-items: center; gap: 0.35rem; background: none; border: 1px solid var(--borda); color: var(--texto); border-radius: 999px; padding: 0.35rem 0.8rem; font: inherit; font-size: 0.85rem; cursor: pointer; }
      .sair svg { width: 16px; height: 16px; }
      .conteudo { padding: clamp(1rem, 2.2vw, 1.8rem); max-width: 1500px; width: 100%; }

      /* cartões e quadros */
      .quadro { background: var(--cartao); border: 1px solid var(--borda); border-radius: 14px; padding: 1.1rem 1.2rem; box-shadow: inset 0 1px 0 rgba(240, 211, 156, 0.06); }
      .quadro h2 { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; font-family: var(--font-body); font-size: 1.05rem; font-weight: 600; margin: 0 0 0.9rem; }
      .quadro h2 small { font-weight: 400; font-size: 0.8rem; color: var(--texto-2); margin-right: auto; margin-left: 0.5rem; }
      .ver { background: none; border: 0; color: var(--ouro); font: inherit; font-size: 0.85rem; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
      .kpis { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem; margin-bottom: 1rem; }
      .kpi { display: flex; align-items: center; gap: 0.9rem; text-align: left; padding: 1rem 1.1rem; border-radius: 14px; border: 1px solid var(--borda); background: var(--cartao); color: var(--texto); font: inherit; cursor: pointer; transition: border-color 0.15s, transform 0.15s; }
      .kpi:hover { border-color: var(--borda-forte); transform: translateY(-1px); }
      .kpi > svg { width: 38px; height: 38px; color: var(--ouro); stroke-width: 1.4; }
      .kpi div { display: flex; flex-direction: column; min-width: 0; }
      .kpi__n { font-size: 1.9rem; font-weight: 600; line-height: 1.05; font-variant-numeric: lining-nums tabular-nums; color: var(--ouro-claro); }
      .kpi__t { font-size: 0.86rem; color: var(--texto); }
      .kpi small { font-size: 0.76rem; color: var(--verde); }
      .kpi.alerta { border-color: rgba(240, 211, 156, 0.75); background: rgba(217, 174, 107, 0.10); }
      .kpi.alerta .kpi__n { color: #f0d39c; }
      .grade { display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: 1rem; margin-bottom: 1rem; }
      .grade.dupla { grid-template-columns: 1fr 1fr; }
      .svg-grafico { width: 100%; height: auto; }
      .g-linha { stroke: rgba(201, 164, 106, 0.16); stroke-width: 1; }
      .g-eixo { fill: var(--texto-2); font-size: 11px; font-family: var(--font-body); }
      .g-traco { fill: none; stroke: var(--ouro); stroke-width: 2.4; }
      .g-ponto { fill: var(--ouro-claro); stroke: #1c100b; stroke-width: 1.5; }
      .demandas { display: flex; flex-direction: column; }
      .demanda { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.7rem 0.2rem; border: 0; border-bottom: 1px solid rgba(201, 164, 106, 0.14); background: none; color: var(--texto); font: inherit; font-size: 0.92rem; text-align: left; cursor: pointer; }
      .demanda b { min-width: 2em; padding: 0.15em 0.55em; border-radius: 999px; background: rgba(201, 164, 106, 0.18); color: var(--texto-2); font-variant-numeric: tabular-nums; text-align: center; }
      .demanda.tem b { background: #d9ae6b; color: #24120a; }
      .rapidas { display: flex; flex-direction: column; gap: 0.55rem; }
      .rapidas button { display: flex; align-items: center; gap: 0.8rem; padding: 0.6rem 0.8rem; border-radius: 10px; border: 1px solid var(--borda); background: rgba(20, 11, 7, 0.35); color: var(--texto); font: inherit; font-size: 0.92rem; cursor: pointer; text-align: left; }
      .rapidas button svg { color: var(--ouro); width: 20px; height: 20px; }
      .rapidas button:hover { border-color: var(--borda-forte); background: rgba(217, 174, 107, 0.08); }
      .mini-linha { display: grid; grid-template-columns: 150px 1fr; gap: 0.15rem 1rem; padding: 0.6rem 0.1rem; border-bottom: 1px solid rgba(201, 164, 106, 0.12); font-size: 0.9rem; }
      .mini-linha .quando { grid-row: span 2; color: var(--texto-2); font-variant-numeric: tabular-nums; font-size: 0.84rem; }
      .mini-linha small { color: var(--texto-2); overflow-wrap: anywhere; }
      .mini-linha small.ok { color: var(--verde); }
      .mini-linha small.pend { color: #e9b77a; }
      .rodape { margin-top: 0.4rem; }

      /* formulários e botões */
      label { display: flex; flex-direction: column; gap: 0.35rem; }
      label > span { font-size: 0.76rem; letter-spacing: 0.04em; color: var(--texto-2); }
      input, select, textarea { font: inherit; font-size: 0.95rem; color: var(--texto); background: rgba(14, 7, 4, 0.55); border: 1px solid var(--borda); border-radius: 8px; padding: 0.6rem 0.75rem; min-height: 42px; color-scheme: dark; }
      input::placeholder, textarea::placeholder { color: rgba(201, 180, 154, 0.55); }
      input:focus, select:focus, textarea:focus { outline: none; border-color: var(--ouro); box-shadow: 0 0 0 3px rgba(217, 174, 107, 0.22); }
      .botao { font: inherit; font-weight: 600; font-size: 0.92rem; border: 1px solid #f0d39c; border-radius: 999px; padding: 0.7rem 1.4rem; cursor: pointer; color: #24120a; background: linear-gradient(180deg, #f0d39c, #c99550 60%, #a8742f); box-shadow: 0 8px 18px rgba(0, 0, 0, 0.3); }
      .botao:disabled { opacity: 0.6; cursor: wait; }
      .botao.pequeno { padding: 0.45rem 1rem; font-size: 0.85rem; }
      .botao.claro { background: rgba(217, 174, 107, 0.12); color: var(--texto); border-color: var(--borda); box-shadow: none; }
      .botao.perigo { background: rgba(232, 214, 183, 0.10); color: #e8d6b7; border-color: rgba(232, 214, 183, 0.55); box-shadow: none; }
      .link { background: none; border: 0; font: inherit; font-size: 0.88rem; color: var(--ouro); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; padding: 0.3rem; }
      .nota { color: var(--texto-2); font-size: 0.86rem; margin: 0.4rem 0; }
      .nota.ok { color: var(--verde); }
      .msg { margin: 0 0 1rem; padding: 0.75rem 1rem; font-size: 0.9rem; border-radius: 10px; border: 1px solid rgba(217, 174, 107, 0.5); background: rgba(217, 174, 107, 0.12); color: var(--texto); }
      .msg-janela { position: sticky; bottom: 0; z-index: 2; margin: 1rem 0 0; box-shadow: 0 -10px 24px rgba(10, 5, 3, 0.55); font-weight: 600; }
      .msg-janela:not([data-tipo='erro']) { background: #3a2a12; border-color: rgba(240, 211, 156, 0.7); color: #f0d39c; }
      .msg[data-tipo='erro'], .cartao-entrar .msg { border-color: rgba(232, 214, 183, 0.55); background: rgba(232, 214, 183, 0.08); }

      /* clientes / listas */
      .convite { margin-bottom: 1rem; }
      .convite h2 { font-family: var(--font-display); font-size: 1.5rem; font-weight: 500; }
      .linha { display: grid; grid-template-columns: 1fr 1.3fr 0.8fr auto; gap: 0.8rem; align-items: end; }
      .busca { margin: 0 0 0.7rem; }
      .busca input { width: 100%; max-width: 420px; }
      .tabela { background: var(--cartao); border: 1px solid var(--borda); border-radius: 14px; padding: 0.3rem 1rem; }
      .linha-t { display: grid; grid-template-columns: 2.2fr 1fr 1fr 1fr auto; gap: 0.8rem; align-items: center; padding: 0.8rem 0.2rem; border-bottom: 1px solid rgba(201, 164, 106, 0.12); font-size: 0.9rem; }
      .linha-t:last-child { border-bottom: 0; }
      .linha-t.reg { grid-template-columns: 1fr 1.3fr 1.2fr 1.6fr; }
      .linha-t.cab { font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--texto-2); }
      .linha-t strong { display: block; font-weight: 500; }
      .linha-t small { color: var(--texto-2); overflow-wrap: anywhere; }
      .destaque { color: #f0d39c; font-weight: 600; }
      .etiqueta { justify-self: start; font-size: 0.74rem; padding: 0.22rem 0.65rem; border-radius: 999px; background: rgba(201, 164, 106, 0.16); color: var(--texto-2); white-space: nowrap; }
      .etiqueta[data-t='ok'] { background: #b9853f; color: #24120a; }
      .etiqueta[data-t='erro'] { background: rgba(232, 214, 183, 0.14); color: #e8d6b7; box-shadow: inset 0 0 0 1px rgba(232, 214, 183, 0.5); }
      .etiqueta[data-t='aviso'] { background: rgba(217, 174, 107, 0.22); color: var(--ouro-claro); }
      .filtro { margin-bottom: 0.9rem; font-size: 0.9rem; color: var(--texto-2); }
      .filtro label { flex-direction: row; align-items: center; gap: 0.4rem; }
      .filtro { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem; }
      .filtro .nota { margin: 0; }
      .item__txt .mensagem { white-space: pre-wrap; margin-top: 0.3rem; padding-left: 0.7rem; border-left: 2px solid var(--borda-forte); font-style: normal; }
      a.botao { text-decoration: none; display: inline-block; }
      .item { display: grid; grid-template-columns: 1fr auto; gap: 0.6rem 1rem; align-items: start; padding: 1rem 1.1rem; margin-bottom: 0.7rem; background: var(--cartao); border: 1px solid var(--borda); border-radius: 12px; }
      .item.feito { opacity: 0.75; }
      .item__txt { display: flex; flex-direction: column; gap: 0.2rem; font-size: 0.88rem; color: var(--texto-2); min-width: 0; }
      .item__txt strong { color: var(--texto); font-size: 1rem; font-weight: 500; overflow-wrap: anywhere; }
      .item__txt em { color: var(--texto); }
      .item__acao { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: end; gap: 0.7rem; }
      .mini input { min-height: 38px; padding: 0.4rem 0.6rem; }
      .check { flex-direction: row; align-items: center; gap: 0.35rem; font-size: 0.85rem; padding-bottom: 0.5rem; color: var(--texto); }
      .check input { min-height: 0; }
      .vazio { color: var(--texto-2); font-style: italic; padding: 0.8rem 0.2rem; margin: 0; }
      .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.86rem; overflow-wrap: anywhere; }

      /* janelas */
      dialog.ficha { width: min(780px, 94vw); max-height: 90vh; border: 1px solid var(--borda-forte); border-radius: 14px; padding: 0 1.4rem 1.4rem; background: #22140d; color: var(--texto); box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6); }
      dialog.pequena { width: min(520px, 94vw); }
      dialog::backdrop { background: rgba(10, 5, 3, 0.7); }
      .ficha__topo { position: sticky; top: 0; z-index: 1; display: flex; justify-content: space-between; align-items: center; padding: 1.1rem 0 0.7rem; background: #22140d; border-bottom: 1px solid var(--borda); margin-bottom: 0.8rem; }
      .ficha__topo h2 { margin: 0; font-size: 1.6rem; color: var(--ouro-claro); overflow-wrap: anywhere; }
      .fechar { background: none; border: 0; font-size: 1.8rem; line-height: 1; cursor: pointer; color: var(--texto-2); }
      .dados { display: grid; grid-template-columns: 170px 1fr; gap: 0.4rem 1rem; margin: 0.4rem 0 0.8rem; font-size: 0.9rem; }
      .dados dt { color: var(--texto-2); }
      .dados dd { margin: 0; overflow-wrap: anywhere; }
      .bloco { border-top: 1px solid var(--borda); padding-top: 0.8rem; margin-top: 0.8rem; }
      .ficha-abas { position: sticky; top: 4.1rem; z-index: 1; display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0.7rem 0; margin-bottom: 0.6rem; background: #22140d; border-bottom: 1px solid var(--borda); }
      .ficha-abas button { font: inherit; font-size: 0.85rem; padding: 0.4rem 0.85rem; border-radius: 999px; cursor: pointer; background: transparent; color: var(--texto); border: 1px solid var(--borda-forte); }
      .ficha-abas button[aria-selected='true'] { background: linear-gradient(180deg, #f0d39c, #c99550); color: #24120a; border-color: transparent; font-weight: 600; }
      .contrato-editor { margin-top: 0.8rem; padding: 0.9rem; border: 1px solid var(--borda); border-radius: 12px; background: rgba(14, 7, 4, 0.35); }
      .contrato-editor h4 { margin: 0 0 0.2rem; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.15rem; color: #f0d39c; }
      .contrato-editor textarea { width: 100%; font-family: ui-monospace, Menlo, monospace; font-size: 0.82rem; line-height: 1.45; }
      .contrato-campos { grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); }
      .contrato-campos input.faltando { border-color: #d9ae6b; box-shadow: 0 0 0 2px rgba(217, 174, 107, 0.35); }
      .acoes-contrato { display: flex; flex-wrap: wrap; gap: 0.5rem 0.8rem; align-items: center; margin: 0.6rem 0; }
      .nota.pend { color: #e9b77a; }
      .fin-det summary { cursor: pointer; color: #e8d6b7; font-size: 0.9rem; margin: 0.4rem 0; }
      .bloco h3 { font-size: 1.25rem; margin: 0 0 0.5rem; color: var(--ouro-claro); }
      .bloco .item { background: rgba(14, 7, 4, 0.4); }
      .fin-sec { margin: 0.8rem 0 1.1rem; }
      .fin-sec h4 { margin: 0 0 0.5rem; font-size: 1rem; color: var(--texto); }
      .fin-linha { display: grid; grid-template-columns: 1.6fr 1fr 1.4fr auto; gap: 0.6rem; align-items: center; padding: 0.45rem 0; border-bottom: 1px solid rgba(201, 164, 106, 0.12); font-size: 0.88rem; }
      .fin-linha b { color: var(--ouro-claro); font-variant-numeric: tabular-nums; }
      .fin-linha small { color: var(--texto-2); }
      .fin-form { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 0.5rem 0.7rem; align-items: end; margin: 0.6rem 0; padding: 0.8rem; border: 1px dashed rgba(201, 164, 106, 0.35); border-radius: 10px; }
      .fin-form .largo { grid-column: span 2; }
      .recusa-op { display: flex; gap: 0.5rem; flex-wrap: wrap; width: 100%; }
      .recusa-op[hidden] { display: none; }
      .motivo-op { flex: 1 1 220px; font: inherit; padding: 0.45rem 0.7rem; border-radius: 8px; border: 1px solid rgba(201, 164, 106, 0.45); background: rgba(20, 11, 7, 0.6); color: #f6f0e6; }
      .fin-form.corrigindo { border-style: solid; border-color: #d9ae6b; background: rgba(217, 174, 107, 0.07); }
      .fin-chips { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.2rem; }
      .fin-chip { font: inherit; font-size: 0.8rem; padding: 0.35rem 0.75rem; border-radius: 999px; cursor: pointer; background: rgba(201, 164, 106, 0.08); color: #e8d6b7; border: 1px solid rgba(201, 164, 106, 0.35); }
      .fin-chip:hover { border-color: #d9ae6b; color: #f0d39c; }
      .fin-chip[aria-pressed='true'] { background: linear-gradient(135deg, #c99550, #e2c08a); color: #2a140d; border-color: transparent; font-weight: 600; }
      .bloco.acoes { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; }
      .bloco.acoes h3 { width: 100%; }
      .evento { display: flex; flex-direction: column; gap: 0.15rem; padding: 0.55rem 0 0.55rem 0.8rem; border-left: 2px solid rgba(201, 164, 106, 0.45); margin-bottom: 0.3rem; font-size: 0.88rem; overflow-wrap: anywhere; }
      .evento small { color: var(--texto-2); }
      .evento strong { font-weight: 500; color: var(--ouro-claro); }
      .evento span { white-space: pre-wrap; }
      .evento.interno { border-left-style: dashed; background: rgba(98, 72, 58, 0.25); }
      .link-doc { color: var(--ouro-claro); overflow-wrap: anywhere; }
      .fin-form textarea { font: inherit; padding: 0.45rem 0.7rem; border-radius: 8px; border: 1px solid rgba(201, 164, 106, 0.45); background: rgba(20, 11, 7, 0.6); color: #f6f0e6; }
      .fin-form .check { flex-direction: row; align-items: center; gap: 0.45rem; display: flex; }
      [data-inst-busca] { font: inherit; padding: 0.45rem 0.7rem; border-radius: 8px; border: 1px solid rgba(201, 164, 106, 0.45); background: rgba(20, 11, 7, 0.6); color: #f6f0e6; min-width: 220px; }
      dialog form { display: grid; gap: 0.8rem; }
      .acoes { display: flex; gap: 0.8rem; align-items: center; }

      @media (max-width: 1250px) { .kpis { grid-template-columns: repeat(3, 1fr); } .grade { grid-template-columns: 1fr 1fr; } .grade .grafico { grid-column: 1 / -1; } }
      @media (max-width: 900px) {
        .app { grid-template-columns: 1fr; }
        .lateral { position: static; height: auto; padding: 0.8rem; flex-direction: column; }
        .marca { border: 0; margin: 0; padding-bottom: 0.6rem; }
        .menu:not(.breve) { flex-direction: row; overflow-x: auto; gap: 0.3rem; }
        .menu:not(.breve) button { width: auto; white-space: nowrap; padding: 0.55rem 0.8rem; }
        .menu-titulo, .menu.breve, .onda { display: none; }
        .lateral { order: 0; }
        .faixa { flex-direction: column; align-items: flex-start; background: linear-gradient(90deg, rgba(28, 16, 11, 0.92) 0%, rgba(28, 16, 11, 0.75) 100%), url('/brand/admin-robo-faixa.jpg') right 22% / cover no-repeat; }
        .quem { margin: 0.6rem 0 0; }
        .kpis { grid-template-columns: 1fr 1fr; }
        .grade, .grade.dupla { grid-template-columns: 1fr; }
        .linha { grid-template-columns: 1fr; }
        .linha-t, .linha-t.reg { grid-template-columns: 1fr 1fr; }
        .linha-t.cab { display: none; }
        .dados { grid-template-columns: 1fr; }
        .fin-linha { grid-template-columns: 1fr 1fr; }
        .fin-form .largo { grid-column: auto; }
        .edicao__grade { grid-template-columns: 1fr; }
        .voltar { position: static; margin-top: 0.6rem; }
        .dados dt { margin-top: 0.4rem; }
        .mini-linha { grid-template-columns: 1fr; }
        .mini-linha .quando { grid-row: auto; }
      }
    </style>
  </body>
