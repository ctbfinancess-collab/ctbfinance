      .linha-t small { color: var(--color-cafe); overflow-wrap: anywhere; }
      .destaque { color: #9a4a2c; font-weight: 500; }
      .etiqueta { justify-self: start; font-size: 0.74rem; padding: 0.22rem 0.6rem; border-radius: 999px; background: #efe8dc; white-space: nowrap; }
      .etiqueta[data-t='ok'] { background: rgba(111, 154, 114, 0.22); color: #2f5a34; }
      .etiqueta[data-t='erro'] { background: rgba(199, 113, 79, 0.2); color: #8b3a1f; }
      .etiqueta[data-t='aviso'] { background: rgba(181, 139, 77, 0.22); color: #6d4a1f; }
      .filtro { margin-bottom: 0.8rem; font-size: 0.9rem; }
      .filtro label { flex-direction: row; align-items: center; gap: 0.4rem; }
      .item { display: grid; grid-template-columns: 1fr auto; gap: 0.6rem 1rem; align-items: start; padding: 1rem 1.1rem; margin-bottom: 0.7rem; background: #fbf8f2; border: 1px solid rgba(98, 72, 58, 0.16); }
      .item.feito { opacity: 0.8; }
      .item__txt { display: flex; flex-direction: column; gap: 0.2rem; font-size: 0.88rem; color: var(--color-cafe); min-width: 0; }
      .item__txt strong { color: var(--color-espresso); font-size: 1rem; font-weight: 500; overflow-wrap: anywhere; }
      .item__txt em { color: var(--color-espresso); }
      .item__acao { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: end; gap: 0.7rem; }
      .mini input { min-height: 38px; padding: 0.4rem 0.6rem; }
      .check { flex-direction: row; align-items: center; gap: 0.35rem; font-size: 0.85rem; padding-bottom: 0.5rem; }
      .check input { min-height: 0; }
      .vazio { color: var(--color-cafe); font-style: italic; padding: 1rem 0.3rem; }
      .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.86rem; overflow-wrap: anywhere; }
      dialog.ficha { width: min(760px, 94vw); max-height: 90vh; border: 1px solid var(--color-line); padding: 0 1.4rem 1.4rem; background: var(--color-ivory); color: var(--color-espresso); box-shadow: 0 30px 70px rgba(53, 36, 29, 0.35); }
      dialog.pequena { width: min(520px, 94vw); }
      dialog::backdrop { background: rgba(35, 13, 8, 0.45); }
      .ficha__topo { position: sticky; top: 0; display: flex; justify-content: space-between; align-items: center; padding: 1.1rem 0 0.6rem; background: var(--color-ivory); border-bottom: 1px solid rgba(98, 72, 58, 0.15); margin-bottom: 0.8rem; }
      .ficha__topo h2 { margin: 0; font-size: 1.6rem; }
      .fechar { background: none; border: 0; font-size: 1.8rem; line-height: 1; cursor: pointer; color: var(--color-cafe); }
      .dados { display: grid; grid-template-columns: 170px 1fr; gap: 0.35rem 1rem; margin: 0.4rem 0 0.8rem; font-size: 0.9rem; }
      .dados dt { color: var(--color-cafe); }
      .dados dd { margin: 0; overflow-wrap: anywhere; }
      .bloco { border-top: 1px solid rgba(98, 72, 58, 0.15); padding-top: 0.8rem; margin-top: 0.8rem; }
      .bloco h3 { font-size: 1.25rem; margin: 0 0 0.5rem; }
