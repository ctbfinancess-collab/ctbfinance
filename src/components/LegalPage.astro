---
import PageBanner from './PageBanner.astro';
import { legal, legalCommon } from '../i18n/legal';
import { routes, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; doc: 'privacy' | 'terms' | 'legal' }
const { lang, doc } = Astro.props;
const d = legal[doc][lang];
const cm = legalCommon[lang];
const t = useTranslations(lang);
const others = (['privacy', 'terms', 'legal'] as const).map((k) => ({ key: k, label: cm[k], href: routes[k][lang], current: k === doc }));
---
<PageBanner image="/brand/banner-politicas.jpg" imageSmall="/brand/banner-politicas-1100.jpg" position="70% 50%" fit="1920 / 819"
  eyebrow={d.eyebrow} title={d.title} lead={d.lead}
  crumbs={[{ label: t('nav.home'), href: routes.home[lang] }, { label: d.title }]} />

<section class="legal">
  <div class="container legal__grid">
    <nav class="legal__nav" aria-label={cm.nav}>
      <p class="legal__nav-title">{cm.nav}</p>
      <ul>
        {others.map((o) => <li><a href={o.href} aria-current={o.current ? 'page' : undefined}>{o.label}</a></li>)}
      </ul>
    </nav>
    <article class="legal__body">
      <p class="legal__meta">{cm.updatedLabel}: {d.updated}</p>
      <p class="legal__draft" role="note">{cm.draft}</p>
      {d.sections.map((s) => (
        <section>
          <h2>{s.h}</h2>
          {s.p.map((para) => <p>{para}</p>)}
        </section>
      ))}
    </article>
  </div>
</section>

<style>
  .legal { background: var(--color-ivory); color: var(--color-espresso); padding-block: clamp(3.5rem, 8vw, 6rem); }
  .legal__grid { display: grid; grid-template-columns: 220px 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .legal__nav { position: sticky; top: 2rem; padding-top: 0.4rem; }
  .legal__nav-title { margin: 0 0 1rem; font-size: 0.72rem; letter-spacing: 0.28em; text-transform: uppercase; color: var(--color-gold); }
  .legal__nav ul { list-style: none; margin: 0; padding: 0; border-left: 1px solid rgba(98, 72, 58, 0.2); }
  .legal__nav a { display: block; padding: 0.55rem 0 0.55rem 1rem; margin-left: -1px; border-left: 1px solid transparent; color: var(--color-cafe); font-size: 0.95rem; }
  .legal__nav a:hover { color: var(--color-espresso); }
  .legal__nav a[aria-current='page'] { color: var(--color-espresso); border-left-color: var(--color-gold); font-weight: 500; }
  .legal__body { max-width: 46rem; }
  .legal__meta { margin: 0; font-size: 0.8rem; letter-spacing: 0.08em; color: var(--color-cafe); }
  .legal__draft { margin: 1rem 0 2.5rem; padding: 0.9rem 1.1rem; border-left: 2px solid var(--color-gold); background: rgba(181, 139, 77, 0.12); font-size: 0.9rem; }
  .legal__body h2 { font-size: clamp(1.4rem, 2vw, 1.7rem); font-weight: 500; margin: 2.2rem 0 0.8rem; color: var(--color-espresso); }
  .legal__body p { margin: 0 0 1rem; color: var(--color-cafe); line-height: 1.75; }
  @media (max-width: 860px) {
    .legal__grid { grid-template-columns: 1fr; }
    .legal__nav { position: static; }
  }
</style>
