      .cartao { background: #fbf8f2; border: 1px solid rgba(98, 72, 58, 0.16); padding: clamp(1.2rem, 2.5vw, 2rem); box-shadow: 0 18px 40px rgba(53, 36, 29, 0.06); }
      .entrar { max-width: 420px; margin: 3rem auto; }
      .entrar h1 { font-size: 2.2rem; margin: 0 0 0.3rem; }
      .entrar form { display: grid; gap: 0.9rem; margin-top: 1.2rem; }
      label { display: flex; flex-direction: column; gap: 0.35rem; }
      label > span { font-size: 0.76rem; letter-spacing: 0.04em; color: var(--color-cafe); }
      input, select, textarea { font: inherit; font-size: 0.95rem; color: var(--color-espresso); background: var(--color-ivory); border: 1px solid rgba(98, 72, 58, 0.28); border-radius: 4px; padding: 0.6rem 0.75rem; min-height: 42px; }
      input:focus, select:focus, textarea:focus { outline: none; border-color: var(--color-gold); box-shadow: 0 0 0 3px rgba(181, 139, 77, 0.2); }
      .botao { font: inherit; font-weight: 500; font-size: 0.92rem; border: 0; border-radius: 999px; padding: 0.7rem 1.4rem; cursor: pointer; color: #2a140d; background: linear-gradient(180deg, #e9c98f, #b9853f); box-shadow: 0 6px 14px rgba(53, 36, 29, 0.15); }
