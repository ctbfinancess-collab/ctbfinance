---
import PageBanner from './PageBanner.astro';
import Button from './Button.astro';
import ImageSlot from './ImageSlot.astro';
import { solutions } from '../i18n/solutions';
import { routes, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = solutions[lang];
const t = useTranslations(lang);

// Ícones de linha dourados para as etapas (mesmo traço da faixa do hero)
const stepIcons = [
  '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M8 9h8"/><path d="M8 13h5"/>',
  '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/><path d="m8.5 11 1.8 1.8 3.2-3.6"/>',
  '<circle cx="12" cy="5" r="2.5"/><circle cx="5" cy="19" r="2.5"/><circle cx="19" cy="19" r="2.5"/><path d="M12 7.5v4"/><path d="M12 11.5 6.5 17"/><path d="m12 11.5 5.5 5.5"/>',
  '<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V3h6v1"/><path d="m9 13 2 2 4-4"/>',
];
const trustIcons = ['/icons/relacionamento.jpg', '/icons/discricao.jpg', '/icons/atendimento.jpg'];
---
<PageBanner
  image="/brand/banner-painel-recorte.jpg" imageSmall="/brand/banner-painel-recorte-900.jpg" position="50% 50%" fit="2172 / 724" side="64%"
  eyebrow={c.banner.eyebrow} title={c.banner.title} lead={c.banner.lead}
  crumbs={[{ label: t('nav.home'), href: routes.home[lang] }, { label: c.banner.crumb }]}
/>

<!-- 1 · Atividades (marfim) -->
<section class="sec sec--ivory on-light">
  <div class="container">
    <header class="head reveal">
      <p class="eyebrow">{c.areas.eyebrow}</p>
      <h2>{c.areas.title}</h2>
      <span class="gold-rule gold-rule--center"></span>
    </header>
    <!-- Faixas alternadas: imagem de um lado, texto do outro -->
    <div class="areas">
      {c.areas.items.map((item, i) => (
        <article class:list={['area', { 'area--flip': i % 2 === 1 }]}>
          <div class="area__media reveal">
            <ImageSlot label={item.alt} alt={item.alt} ratio="2172 / 724" natural
              src={item.image ? `/brand/${item.image}.jpg` : undefined}
              srcSmall={item.image ? `/brand/${item.image}-900.jpg` : undefined} />
          </div>
          <div class="area__body reveal" style="--d:120ms">
            <div class="area__top">
              <img class="medal" src={`/icons/${item.icon}.jpg`} alt="" width="72" height="72" loading="lazy" />
              <span class="area__num">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3>{item.title}</h3>
            {lang === 'pt' && <p class="area__license" lang="en">{item.license}</p>}
            <span class="area__rule"></span>
            <p class="area__text">{item.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- 2 · Como trabalhamos (espresso) -->
<section class="sec sec--dark">
  <div class="container">
    <header class="head reveal">
      <p class="eyebrow">{c.process.eyebrow}</p>
      <h2>{c.process.title}</h2>
      <span class="gold-rule gold-rule--center"></span>
    </header>
    <ol class="steps">
      {c.process.steps.map((s, i) => (
        <li class="reveal" style={`--d:${i * 90}ms`}>
          <span class="steps__icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={stepIcons[i]} /></span>
          <span class="steps__num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- 3 · Transparência, confidencialidade e conformidade (marfim) -->
<section class="sec sec--ivory on-light">
  <div class="container">
    <header class="head reveal">
      <p class="eyebrow">{c.trust.eyebrow}</p>
      <h2>{c.trust.title}</h2>
      <span class="gold-rule gold-rule--center"></span>
    </header>
    <ul class="trust">
      {c.trust.items.map((item, i) => (
        <li class="reveal" style={`--d:${i * 90}ms`}>
          <img class="medal medal--sm" src={trustIcons[i]} alt="" width="68" height="68" loading="lazy" />
          <div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        </li>
      ))}
    </ul>
    <p class="disclaimer reveal">{c.trust.disclaimer}</p>
  </div>
</section>

<!-- 4 · Chamada para contato -->
<section class="band">
  <div class="container band__inner reveal">
    <div>
      <h2>{c.cta.title}</h2>
      <p>{c.cta.text}</p>
    </div>
    <Button href={routes.contact[lang]} variant="primary" arrow blockMobile>{c.cta.button}</Button>
  </div>
</section>

<script>
  const els = document.querySelectorAll<HTMLElement>('.reveal');
  if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    els.forEach((el) => el.classList.add('is-visible'));
  } else {
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
    }), { rootMargin: '0px 0px -10% 0px', threshold: 0.12 });
    els.forEach((el) => io.observe(el));
  }
</script>

<style>
  .sec { padding-block: clamp(4.5rem, 10vw, 8rem); }
  .sec--ivory { background: var(--color-ivory); color: var(--color-espresso); }
  .sec--dark { background: var(--color-espresso); color: var(--color-ivory); }
  .on-light .eyebrow { color: var(--color-cafe); }
  .sec--dark .eyebrow { color: var(--color-gold); }
  h2 { font-size: clamp(2.1rem, 4vw, 3.2rem); font-weight: 400; line-height: 1.1; margin: 0.9rem 0 0; text-wrap: balance; }
  .sec--dark h2 { color: var(--color-champagne); }
  h3 { font-size: 1.6rem; font-weight: 500; margin: 0; text-wrap: balance; }
  .gold-rule { display: block; width: 72px; height: 1px; background: var(--color-gold); margin: 1.6rem 0; }
  .gold-rule--center { margin-inline: auto; }
  .head { text-align: center; max-width: 46rem; margin: 0 auto clamp(3rem, 6vw, 4.5rem); }
  .medal { flex: none; width: 84px; height: 84px; border-radius: 50%; clip-path: circle(47% at 50% 50%); box-shadow: 0 10px 22px rgba(53, 36, 29, 0.25); transition: transform 0.5s cubic-bezier(.2,.7,.2,1); }
  .medal--sm { width: 68px; height: 68px; }

  /* Atividades — faixas alternadas */
  .areas { display: grid; gap: clamp(3rem, 6vw, 5rem); }
  .area { display: grid; grid-template-columns: 1.35fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .area--flip { grid-template-columns: 1fr 1.35fr; }
  .area--flip .area__media { order: 2; }
  .area__media .slot { border: 1px solid rgba(181, 139, 77, 0.35); box-shadow: 0 22px 46px rgba(53, 36, 29, 0.18); }
  .area__top { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.4rem; }
  .area__top .medal { width: 72px; height: 72px; }
  .area__num { font-family: var(--font-display); color: var(--color-gold); letter-spacing: 0.2em; font-size: 1.1rem; }
  .area h3 { color: var(--color-espresso); font-size: clamp(1.8rem, 2.6vw, 2.3rem); font-weight: 400; }
  .area__license { margin: 0.4rem 0 0; font-family: var(--font-display); font-style: italic; font-size: 1.15rem; color: var(--color-gold); }
  .area__rule { display: block; width: 56px; height: 1px; background: var(--color-gold); margin: 1.3rem 0; }
  .area__text { margin: 0; color: var(--color-cafe); }
  .area:hover .medal { transform: translateY(-3px) scale(1.04); }

  /* Etapas */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1.5rem, 3vw, 2.5rem); position: relative; }
  .steps::before { content: ''; position: absolute; top: 40px; left: 12.5%; right: 12.5%; height: 1px; background: var(--color-line); }
  .steps li { position: relative; text-align: center; }
  .steps__icon { position: relative; z-index: 1; display: grid; place-items: center; width: 80px; height: 80px; margin: 0 auto 1.2rem; border-radius: 50%; border: 1px solid var(--color-gold); background: var(--color-espresso); box-shadow: inset 0 0 0 6px rgba(181, 139, 77, 0.08); transition: background 0.4s ease, transform 0.4s ease; }
  .steps li:hover .steps__icon { background: #42302a; transform: translateY(-3px); }
  .steps svg { width: 30px; height: 30px; fill: none; stroke: var(--color-champagne); stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
  .steps__num { display: block; font-family: var(--font-display); color: var(--color-gold); letter-spacing: 0.2em; margin-bottom: 0.4rem; }
  .steps h3 { color: var(--color-champagne); margin-bottom: 0.7rem; }
  .steps p { margin: 0; color: var(--color-ivory); opacity: 0.8; font-size: 0.95rem; }

  /* Princípios */
  .trust { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 3vw, 3rem); }
  .trust li { display: flex; gap: 1.2rem; align-items: flex-start; padding-top: 1.8rem; border-top: 1px solid rgba(98, 72, 58, 0.18); }
  .trust h3 { color: var(--color-espresso); margin-bottom: 0.5rem; }
  .trust p { margin: 0; color: var(--color-cafe); font-size: 0.95rem; }
  .disclaimer { margin: clamp(2.5rem, 5vw, 3.5rem) auto 0; max-width: 50rem; padding: 1.4rem 1.8rem; border: 1px solid rgba(181, 139, 77, 0.35); background: #fbf8f2; text-align: center; font-size: 0.88rem; color: var(--color-cafe); }

  /* Chamada */
  .band { background: linear-gradient(120deg, var(--color-espresso) 0%, var(--color-cafe) 140%); color: var(--color-ivory); border-top: 1px solid var(--color-line); }
  .band__inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding-block: clamp(3rem, 6vw, 4.5rem); }
  .band h2 { color: var(--color-champagne); font-size: clamp(1.8rem, 3vw, 2.5rem); margin: 0 0 0.6rem; }
  .band p { margin: 0; opacity: 0.85; }

  .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.9s ease, transform 0.9s ease; transition-delay: var(--d, 0ms); }
  .reveal.is-visible { opacity: 1; transform: none; }

  @media (max-width: 1000px) {
    .trust { grid-template-columns: 1fr; }
    .area, .area--flip { grid-template-columns: 1fr; }
    .area--flip .area__media { order: 0; }
    .steps { grid-template-columns: repeat(2, 1fr); row-gap: 3rem; }
    .steps::before { display: none; }
    .band__inner { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 520px) {
    .steps { grid-template-columns: 1fr; }
  }
</style>
