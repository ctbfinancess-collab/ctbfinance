  opsEnviar: 'Enviar solicitação', opsEnviando: 'Enviando…', opsOk: 'Solicitação recebida. Nossa equipe vai analisar e você acompanha a situação abaixo.',
  opsMinhas: 'Minhas solicitações', opsNenhuma: 'Você ainda não fez nenhuma solicitação.', opsSemConta: 'As solicitações ficam disponíveis depois que a nossa equipe registrar a sua conta. Agende uma conversa para começar.',
  opsMotivo: 'Motivo', opsLancada: 'Lançada no seu extrato',
  opsTipos: { transferencia_local: 'Transferência local (UAE)', transferencia_swift: 'Transferência internacional (SWIFT)', cambio: 'Câmbio' },
  opsStatus: { recebida: 'Recebida', em_analise: 'Em análise', concluida: 'Concluída', recusada: 'Recusada' },
  opsErros: { valor_invalido: 'Confira o valor (ex.: 8.000,00).', moeda_invalida: 'Escolha uma moeda diferente da moeda da conta.', beneficiario_obrigatorio: 'Informe o nome do beneficiário.', iban_obrigatorio: 'Informe o IBAN ou número da conta.', swift_invalido: 'Confira o código SWIFT/BIC (8 ou 11 caracteres).', conta_invalida: 'Escolha a conta.', tipo_invalido: 'Escolha a operação.', limite_operacoes: 'Você já tem várias solicitações em aberto. Aguarde a análise da nossa equipe.', geral: 'Não foi possível enviar. Tente de novo.' },
  tipos: { digital: 'Conta Digital', global: 'Conta Global', investimentos: 'Conta Investimentos' },
  classes: { renda_fixa: 'Renda fixa', renda_variavel: 'Renda variável', fundos: 'Fundos', alternativos: 'Alternativos', exterior: 'Exterior' },
  situacoes: { ativo: 'Ativo', bloqueado: 'Bloqueado', em_emissao: 'Em emissão' },
  inst: {
    titulo: 'Instrumentos financeiros internacionais', intro: 'Solicite SBLC, LC, garantias bancárias e outros instrumentos e acompanhe cada etapa aqui. Você pode salvar um rascunho e enviar quando estiver completo.',
    aviso: 'O envio da solicitação não representa aprovação nem emissão do instrumento. A emissão é feita exclusivamente por instituição financeira habilitada.',
    nova: 'Nova solicitação de instrumento', editar: 'Editar solicitação', garantias: 'Garantias e cartas de crédito', declaracoes: 'Declarações e comprovações (não são garantias bancárias)',
    instrumento: 'Instrumento', moeda: 'Moeda', valor: 'Valor', validade: 'Validade solicitada', benef: 'Beneficiário', nome: 'Nome / empresa', pais: 'País', endereco: 'Endereço', banco: 'Banco do beneficiário',
    ordenante: 'Ordenante (solicitante)', ordNome: 'Nome / empresa', ordId: 'Identificação (passaporte, registro)', finalidade: 'Finalidade', sugFinalidade: ['Monetização', 'Garantia de pagamento', 'Linha de crédito / financiamento', 'Compra de commodities', 'Importação / exportação', 'Garantia de performance contratual', 'Projeto / investimento'], operacao: 'Operação comercial subjacente', emissor: 'Banco emissor proposto (se conhecido)', avisador: 'Banco avisador (se aplicável)', contrato: 'Contrato / documento de referência', obs: 'Observações adicionais',
    salvar: 'Salvar rascunho', enviar: 'Enviar solicitação', reenviar: 'Reenviar para análise', fechar: 'Fechar', salvo: 'Rascunho salvo.', enviado: 'Solicitação enviada. Referência:', reenviado: 'Reenviada para análise.',
    faltam: 'Para enviar, preencha:', minhas: 'Minhas solicitações de instrumentos', nenhuma: 'Nenhuma solicitação de instrumento ainda.', rascunho: 'Rascunho', anexar: 'Anexar arquivo (PDF, JPG, PNG)', anexado: 'Arquivo anexado.', cancelar: 'Cancelar solicitação', cancelarConf: 'Cancelar esta solicitação?', cancelada: 'Solicitação cancelada.',
