---
import PageBanner from './PageBanner.astro';
import { contact } from '../i18n/contact';
import { company } from '../i18n/company';
import { routes, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = contact[lang];
const t = useTranslations(lang);
const formReady = Boolean(company.formEndpoint);
---
<PageBanner
  video="/video/ctb-mao-financeira" image="/video/ctb-mao-financeira-poster.jpg" natural side="66%"
  eyebrow={c.banner.eyebrow} title={c.banner.title} lead={c.banner.lead}
  crumbs={[{ label: t('nav.home'), href: routes.home[lang] }, { label: c.banner.crumb }]}
/>

<section class="contact-sec">
  <div class="container grid">
    <!-- Informações institucionais -->
    <aside class="info">
      <p class="eyebrow">{c.info.eyebrow}</p>
      <h2>{c.info.title}</h2>
      <span class="gold-rule"></span>
      <ul>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21h18"/><path d="M5 21V8l7-4 7 4v13"/><path d="M9 21v-5h6v5"/></svg>
          <span><strong>{company.legalName}</strong></span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>
          <span>{c.info.location}</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
          <span><small>{c.info.phoneLabel}</small><a href={company.phoneHref}>{company.phone}</a></span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          <span><small>{c.info.emailLabel}</small>{company.emailConfirmed ? <a href={`mailto:${company.email}`}>{company.email}</a> : <em>{c.info.emailPending}</em>}</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6"/><path d="m9 15 2 2 4-4"/></svg>
          <span>{c.info.licenseLabel} {company.tradeLicense}</span>
        </li>
      </ul>
    </aside>

    <!-- Formulário -->
    <div class="form-card">
      <h2>{c.form.title}</h2>
      <form action={formReady ? company.formEndpoint : undefined} method="post" class="form" novalidate data-contact-form
        data-msg-sending={c.form.sending} data-msg-success={c.form.success} data-msg-error={c.form.error}
        data-msg-invalid={c.form.invalid} data-msg-rate={c.form.rateLimit}>
        <input type="hidden" name="lang" value={lang} />
        <input type="hidden" name="started_at" value="" data-started-at />
        <!-- armadilha anti-spam (invisível para pessoas) -->
        <div class="hp" aria-hidden="true">
          <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <fieldset disabled={!formReady}>
          <div class="row">
            <label>
              <span>{c.form.name} *</span>
              <input type="text" name="name" required minlength="3" maxlength="120" autocomplete="name" />
            </label>
            <label>
              <span>{c.form.email} *</span>
              <input type="email" name="email" required maxlength="160" autocomplete="email" />
            </label>
          </div>
          <div class="row">
            <label>
              <span>{c.form.phone}</span>
              <input type="tel" name="phone" maxlength="25" pattern="^\+?[0-9 ()\-]{7,25}$" placeholder={c.form.phonePlaceholder} autocomplete="tel" />
            </label>
            <label>
              <span>{c.form.subject} *</span>
              <select name="subject" required>
                <option value="" disabled selected>{c.form.subjectPlaceholder}</option>
                {c.form.subjects.map((s) => <option value={s}>{s}</option>)}
              </select>
            </label>
          </div>
          <label>
            <span>{c.form.message} *</span>
            <textarea name="message" rows="6" required minlength="10" maxlength="3000"></textarea>
          </label>
          <label class="consent">
            <input type="checkbox" name="consent" value="on" required />
            <span>{c.form.consent} <a href={routes.privacy[lang]} target="_blank">{c.form.privacyLink}</a></span>
          </label>
          <div class="actions">
            <button type="submit" class="btn btn--primary" data-submit>
              {c.form.submit}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
            </button>
            <small>* {c.form.required}</small>
          </div>
        </fieldset>
        <p class="form-status" role="status" aria-live="polite" hidden data-status></p>
      </form>
    </div>
  </div>
</section>

<script>
  // Executa a cada página (navegação contínua do site, para a música não parar)
  function init() {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (form && form.getAttribute('action')) {
      const status = form.querySelector<HTMLElement>('[data-status]')!;
      const btn = form.querySelector<HTMLButtonElement>('[data-submit]')!;
      const started = form.querySelector<HTMLInputElement>('[data-started-at]')!;
      started.value = String(Date.now());
      const label = btn.innerHTML;
      const show = (msg: string, kind: 'ok' | 'err' | 'info') => {
        status.hidden = false; status.textContent = msg; status.dataset.kind = kind;
      };
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        form.querySelectorAll('.is-invalid').forEach((el) => el.classList.remove('is-invalid'));
        if (!form.checkValidity()) {
          form.querySelectorAll<HTMLElement>(':invalid').forEach((el) => el.classList.add('is-invalid'));
          (form.querySelector(':invalid') as HTMLElement | null)?.focus();
          return show(form.dataset.msgInvalid!, 'err');
        }
        btn.disabled = true; btn.textContent = form.dataset.msgSending!;
        try {
          const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
          const r = await fetch(form.action, { method: 'POST', body, headers: { Accept: 'application/json' } });
          const j = await r.json().catch(() => ({}));
          if (r.ok && j.ok) { form.reset(); started.value = String(Date.now()); return show(form.dataset.msgSuccess!, 'ok'); }
          if (r.status === 422 && Array.isArray(j.fields)) {
            j.fields.forEach((f: string) => form.querySelector(`[name="${f}"]`)?.classList.add('is-invalid'));
            return show(form.dataset.msgInvalid!, 'err');
          }
          if (r.status === 429) return show(form.dataset.msgRate!, 'err');
          show(form.dataset.msgError!, 'err');
        } catch {
          show(form.dataset.msgError!, 'err');
        } finally {
          btn.disabled = false; btn.innerHTML = label;
        }
      });
    }
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .form-status { margin: 1.4rem 0 0; padding: 0.9rem 1.1rem; border-left: 2px solid var(--color-gold); background: rgba(181, 139, 77, 0.12); font-size: 0.92rem; color: var(--color-espresso); }
  .form-status[data-kind='ok'] { border-left-color: #4f7a52; background: rgba(79, 122, 82, 0.12); }
  .form-status[data-kind='err'] { border-left-color: #a5523a; background: rgba(165, 82, 58, 0.1); }
  :global(.is-invalid) { border-color: #a5523a !important; box-shadow: 0 0 0 3px rgba(165, 82, 58, 0.15) !important; }
  .actions .btn:disabled { opacity: 0.7; cursor: wait; transform: none; }
  .contact-sec { background: var(--color-ivory); color: var(--color-espresso); padding-block: clamp(4rem, 9vw, 7rem); }
  .grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  h2 { font-size: clamp(1.9rem, 3vw, 2.6rem); font-weight: 400; line-height: 1.1; margin: 0.8rem 0 0; }
  .gold-rule { display: block; width: 72px; height: 1px; background: var(--color-gold); margin: 1.5rem 0; }

  .info { padding: clamp(2rem, 3.5vw, 2.8rem); background: var(--color-espresso); color: var(--color-ivory); border: 1px solid var(--color-line); position: relative; }
  .info::before { content: ''; position: absolute; inset: 8px; border: 1px solid rgba(181, 139, 77, 0.25); pointer-events: none; }
  .info .eyebrow { color: var(--color-gold); }
  .info h2 { color: var(--color-champagne); }
  .info ul { list-style: none; margin: 0; padding: 0; }
  .info li { display: flex; gap: 1rem; align-items: flex-start; padding: 1rem 0; border-top: 1px solid var(--color-line); }
  .info li:first-child { border-top: 0; padding-top: 0; }
  .info svg { flex: none; width: 22px; height: 22px; margin-top: 2px; fill: none; stroke: var(--color-gold); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .info span { display: flex; flex-direction: column; gap: 0.15rem; font-size: 0.98rem; }
  .info small { font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-gold); }
  .info strong { font-family: var(--font-display); font-weight: 500; font-size: 1.25rem; letter-spacing: 0.04em; color: var(--color-champagne); }
  .info a { color: var(--color-ivory); }
  .info a:hover { color: var(--color-gold); }
  .info em { font-style: italic; color: var(--color-champagne); opacity: 0.7; }

  .form-card { padding: clamp(2rem, 3.5vw, 2.8rem); background: #fbf8f2; border: 1px solid rgba(98, 72, 58, 0.16); box-shadow: 0 24px 50px rgba(53, 36, 29, 0.08); }
  .form-card h2 { margin: 0 0 1.8rem; color: var(--color-espresso); }
  fieldset { border: 0; margin: 0; padding: 0; display: grid; gap: 1.1rem; min-width: 0; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
  label { display: flex; flex-direction: column; gap: 0.4rem; }
  label > span { font-size: 0.8rem; letter-spacing: 0.04em; color: var(--color-cafe); }
  input, select, textarea { font: inherit; font-size: 1rem; color: var(--color-espresso); background: var(--color-ivory); border: 1px solid rgba(98, 72, 58, 0.25); border-radius: 4px; padding: 0.8rem 0.9rem; min-height: 48px; width: 100%; transition: border-color 0.2s ease, box-shadow 0.2s ease; }
  textarea { resize: vertical; min-height: 140px; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--color-gold); box-shadow: 0 0 0 3px rgba(181, 139, 77, 0.2); }
  input:user-invalid, select:user-invalid, textarea:user-invalid { border-color: #a5523a; }
  .consent { flex-direction: row; align-items: flex-start; gap: 0.7rem; }
  .consent input { width: 18px; height: 18px; min-height: 0; margin-top: 3px; accent-color: var(--color-gold); flex: none; }
  .consent span { font-size: 0.85rem; line-height: 1.5; }
  .consent a { color: var(--color-gold-deep, #a8843f); text-decoration: underline; text-underline-offset: 2px; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 0.4rem; }
  .actions small { font-size: 0.75rem; color: var(--color-cafe); }
  fieldset:disabled { opacity: 0.55; }
  fieldset:disabled .btn { cursor: not-allowed; transform: none; }
  .unavailable { margin: 1.4rem 0 0; padding: 0.9rem 1.1rem; border-left: 2px solid var(--color-gold); background: rgba(181, 139, 77, 0.12); font-size: 0.9rem; color: var(--color-espresso); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  @media (max-width: 1000px) { .grid { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .row { grid-template-columns: 1fr; } .actions .btn { width: 100%; justify-content: center; } }
</style>
