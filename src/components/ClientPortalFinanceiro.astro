---
/**
 * Telas FINANCEIRAS da Área do Cliente (Início, Conta, Investimentos, Cartões, Operações) com os dados REAIS
 * de cada cliente, lançados pela equipe no Admin (GET /api/cliente/financeiro). Sem dados lançados, mostra um
 * aviso — nunca números inventados. Dados do cliente sempre inseridos como TEXTO.
 * O ClientPortal dispara o evento "ctb:financeiro" com os dados da sessão atual (ou null ao sair).
 */
import type { Lang } from '../i18n/ui';
import { routes } from '../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const T = en ? {
  saldo: 'Available balance', semDados: 'Your balances will appear here as soon as our team records them.', atualizado: 'Updated on',
  atalhos: 'Quick access', extrato: 'Statement', transferencias: 'Transfers', investimentos: 'Investments', cambio: 'Exchange', cartoes: 'Cards',
  proxAg: 'Next appointment', docs: 'Documents', verTodos: 'See all', abrir: 'Open', contas: 'Accounts', movimentacoes: 'Transactions',
  semMov: 'No transactions recorded yet.', credito: 'Credit', debito: 'Debit', patrimonio: 'Invested assets', carteira: 'Portfolio by asset class', posicoes: 'Positions',
  semInv: 'Your investment positions will appear here as soon as our team records them.', semCartao: 'You do not have a CTB Finances card yet. To request one, talk to our team.',
  cartaoFinal: 'Card ending in', situacao: 'Status', limite: 'Limit', fatura: 'Current statement', vencimento: 'Due date',
  opsTitulo: 'Transfers and currency exchange', opsTexto: 'Transfers (local or SWIFT) and currency exchange are carried out with our team, with personal service and the required checks. Book a conversation or talk to us.',
  agendar: 'Book a conversation', falar: 'Talk to our team',
  tipos: { digital: 'Digital Account', global: 'Global Account', investimentos: 'Investment Account' },
  classes: { renda_fixa: 'Fixed income', renda_variavel: 'Equities', fundos: 'Funds', alternativos: 'Alternatives', exterior: 'International' },
  situacoes: { ativo: 'Active', bloqueado: 'Locked', em_emissao: 'Being issued' },
} : {
  saldo: 'Saldo disponível', semDados: 'Seus saldos aparecerão aqui assim que a nossa equipe registrar.', atualizado: 'Atualizado em',
  atalhos: 'Acesso rápido', extrato: 'Extrato', transferencias: 'Transferências', investimentos: 'Investimentos', cambio: 'Câmbio', cartoes: 'Cartões',
  proxAg: 'Próximo agendamento', docs: 'Documentos', verTodos: 'Ver todos', abrir: 'Abrir', contas: 'Contas', movimentacoes: 'Movimentações',
  semMov: 'Nenhuma movimentação registrada ainda.', credito: 'Crédito', debito: 'Débito', patrimonio: 'Patrimônio investido', carteira: 'Carteira por classe de ativo', posicoes: 'Posições',
  semInv: 'Suas posições de investimento aparecerão aqui assim que a nossa equipe registrar.', semCartao: 'Você ainda não tem cartão CTB Finances. Para solicitar, fale com a nossa equipe.',
  cartaoFinal: 'Cartão final', situacao: 'Situação', limite: 'Limite', fatura: 'Fatura atual', vencimento: 'Vencimento',
  opsTitulo: 'Transferências e câmbio', opsTexto: 'Transferências (locais ou SWIFT) e câmbio são feitos com a nossa equipe, com atendimento personalizado e as verificações necessárias. Agende uma conversa ou fale com a gente.',
  agendar: 'Agendar conversa', falar: 'Falar com a equipe',
  tipos: { digital: 'Conta Digital', global: 'Conta Global', investimentos: 'Conta Investimentos' },
  classes: { renda_fixa: 'Renda fixa', renda_variavel: 'Renda variável', fundos: 'Fundos', alternativos: 'Alternativos', exterior: 'Exterior' },
  situacoes: { ativo: 'Ativo', bloqueado: 'Bloqueado', em_emissao: 'Em emissão' },
};
---
<div class="fin" data-fin data-lang={lang} data-t={JSON.stringify(T)}>
  <!-- Início -->
  <section data-panel="inicio">
    <div class="saldo">
      <img src="/video/hero-1-poster.jpg" alt="" class="saldo__fundo" loading="lazy" />
      <div class="saldo__conteudo">
        <span class="saldo__rotulo">{T.saldo}</span>
        <strong class="saldo__valor" data-fin-saldo>—</strong>
        <div class="saldo__contas" data-fin-contas-resumo></div>
        <span class="saldo__nota" data-fin-atualizado></span>
      </div>
    </div>
    <h3>{T.atalhos}</h3>
    <div class="atalhos">
      <button type="button" data-ir-aba="conta"><svg viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6z"/><path d="M9 12h6M9 16h6"/></svg>{T.extrato}</button>
      <button type="button" data-ir-aba="operacoes"><svg viewBox="0 0 24 24"><path d="M4 8h14l-3-3M20 16H6l3 3"/></svg>{T.transferencias}</button>
      <button type="button" data-ir-aba="investimentos"><svg viewBox="0 0 24 24"><path d="M4 20h16M6 16v-4M10 16V9M14 16v-6M18 16V6"/></svg>{T.investimentos}</button>
      <button type="button" data-ir-aba="operacoes"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M14.5 9.5c-.5-1-1.5-1.5-2.5-1.5-1.4 0-2.5.8-2.5 2s1.1 1.7 2.5 2 2.5.8 2.5 2-1.1 2-2.5 2c-1 0-2-.5-2.5-1.5M12 6v12"/></svg>{T.cambio}</button>
      <button type="button" data-ir-aba="cartoes"><svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/></svg>{T.cartoes}</button>
    </div>
    <div class="duas">
      <div class="quadro"><div class="quadro__topo"><h4>{T.proxAg}</h4><button type="button" class="link" data-ir-aba="appointments">{T.verTodos}</button></div><p class="real" data-inicio-agenda>—</p></div>
      <div class="quadro"><div class="quadro__topo"><h4>{T.docs}</h4><button type="button" class="link" data-ir-aba="documents">{T.abrir}</button></div><p class="real" data-inicio-docs>—</p></div>
    </div>
  </section>

  <!-- Conta: saldos e extrato -->
  <section data-panel="conta" hidden>
    <h3>{T.contas}</h3>
    <div class="saldos" data-fin-contas></div>
    <h3>{T.movimentacoes}</h3>
    <ul class="mov" data-fin-mov></ul>
  </section>

  <!-- Investimentos -->
  <section data-panel="investimentos" hidden>
    <div data-fin-inv></div>
  </section>

  <!-- Cartões -->
  <section data-panel="cartoes" hidden>
    <div class="cartao-grid">
      <img src="/brand/area/cartao-ctb.jpg" alt="CTB Finances" class="cartao-img" loading="lazy" />
      <div data-fin-cartao></div>
    </div>
  </section>

  <!-- Operações -->
  <section data-panel="operacoes" hidden>
    <h3>{T.opsTitulo}</h3>
    <p class="real">{T.opsTexto}</p>
    <div class="ops-acoes">
      <button type="button" class="btn-ouro" data-ir-aba="appointments">{T.agendar}</button>
      <a class="btn-linha" href={routes.contact[lang]}>{T.falar}</a>
    </div>
  </section>
</div>

<script>
  type Conta = { id: string; tipo: string; moeda: string; saldo: string; atualizado_em: string };
  const raiz = document.querySelector<HTMLElement>('[data-fin]');
  if (raiz && !raiz.dataset.pronto) {
    raiz.dataset.pronto = '1';
    const T = JSON.parse(raiz.dataset.t!);
    const en = raiz.dataset.lang === 'en';
    const loc = en ? 'en-GB' : 'pt-BR';
    const $ = (s: string) => raiz.querySelector<HTMLElement>(s)!;
    const el = (tag: string, cls = '', txt?: string) => { const e = document.createElement(tag); if (cls) e.className = cls; if (txt !== undefined) e.textContent = txt; return e; };
    // centavos (texto) → "AED 28.750,00"
    const valor = (c: string | number | bigint, moeda: string) => {
      const n = BigInt(c); const neg = n < 0n; const a = neg ? -n : n;
      const inteiro = (a / 100n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, en ? ',' : '.');
      return `${neg ? '− ' : ''}${moeda} ${inteiro}${en ? '.' : ','}${(a % 100n).toString().padStart(2, '0')}`;
    };
    const dataC = (s: string) => new Date(`${s}T12:00:00Z`).toLocaleDateString(loc, { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
    const vazio = (txt: string) => el('p', 'vazio', txt);

    function render(d: any | null) {
      // limpa sempre (troca de sessão nunca mostra dados de outra pessoa)
      ['[data-fin-contas-resumo]', '[data-fin-contas]', '[data-fin-mov]', '[data-fin-inv]', '[data-fin-cartao]'].forEach((s) => $(s).replaceChildren());
      $('[data-fin-saldo]').textContent = '—'; $('[data-fin-atualizado]').textContent = '';
      if (!d) return;
      const contas: Conta[] = d.contas || [];
      // Início: saldo principal = conta digital em AED (ou a primeira conta)
      const principal = contas.find((c) => c.tipo === 'digital' && c.moeda === 'AED') || contas[0];
      $('[data-fin-saldo]').textContent = principal ? valor(principal.saldo, principal.moeda) : '—';
      if (!contas.length) $('[data-fin-contas-resumo]').append(el('span', 'saldo__vazio', T.semDados));
      for (const c of contas) { const b = el('div'); b.append(el('span', '', T.tipos[c.tipo] || c.tipo), el('b', '', valor(c.saldo, c.moeda))); $('[data-fin-contas-resumo]').append(b); }
      if (d.atualizadoEm) $('[data-fin-atualizado]').textContent = `${T.atualizado} ${new Date(d.atualizadoEm).toLocaleDateString(loc, { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'Asia/Dubai' })}`;
      // Conta
      if (!contas.length) $('[data-fin-contas]').append(vazio(T.semDados));
      for (const c of contas) { const q = el('div', 'quadro'); q.append(el('span', '', `${T.tipos[c.tipo] || c.tipo} · ${c.moeda}`), el('strong', '', valor(c.saldo, c.moeda))); $('[data-fin-contas]').append(q); }
      const movs = d.movimentos || [];
      if (!movs.length) $('[data-fin-mov]').append(Object.assign(el('li', 'vazio-li'), { textContent: T.semMov }));
      for (const m of movs) {
        const cred = BigInt(m.valor) > 0n;
        const li = el('li');
        const seta = el('span', 'mov__seta', cred ? '↓' : '↑'); seta.dataset.t = cred ? 'credito' : 'debito';
        const desc = el('span', 'mov__desc', m.descricao); desc.append(el('small', '', `${dataC(m.data)} · ${T.tipos[m.conta_tipo] || ''}`));
        const v = el('span', 'mov__valor', `${cred ? '+ ' : ''}${valor(m.valor, m.moeda)}`); v.append(el('small', '', cred ? T.credito : T.debito));
        li.append(seta, desc, v); $('[data-fin-mov]').append(li);
      }
      // Investimentos: total por moeda e distribuição por classe dentro de cada moeda
      const pos = d.posicoes || [];
      const inv = $('[data-fin-inv]');
      if (!pos.length) inv.append(vazio(T.semInv));
      const porMoeda = new Map<string, any[]>(); for (const p of pos) porMoeda.set(p.moeda, [...(porMoeda.get(p.moeda) || []), p]);
      for (const [moeda, lista] of porMoeda) {
        const total = lista.reduce((s: bigint, p: any) => s + BigInt(p.valor), 0n);
        const q = el('div', 'quadro'); q.append(el('span', 'nota', `${T.patrimonio} · ${moeda}`), el('strong', 'grande', valor(total, moeda)));
        q.append(el('h4', 'sub', T.carteira));
        const ul = el('ul', 'carteira');
        const porClasse = new Map<string, bigint>(); for (const p of lista) porClasse.set(p.classe, (porClasse.get(p.classe) || 0n) + BigInt(p.valor));
        for (const [classe, v] of porClasse) {
          const pct = total > 0n ? Number((v * 1000n) / total) / 10 : 0;
          const li = el('li'); const barra = el('span', 'barra'); const i = el('i'); i.style.width = `${pct}%`; barra.append(i);
          li.append(el('span', '', T.classes[classe] || classe), barra, el('b', '', `${pct.toLocaleString(loc, { maximumFractionDigits: 1 })}%`)); ul.append(li);
        }
        q.append(ul, el('h4', 'sub', T.posicoes));
        const lp = el('ul', 'lista-simples');
        for (const p of lista) { const li = el('li'); li.append(el('span', '', `${p.descricao} · ${T.classes[p.classe] || p.classe}`), el('b', '', valor(p.valor, p.moeda))); lp.append(li); }
        q.append(lp); inv.append(q);
      }
      // Cartão
      const k = d.cartao; const box = $('[data-fin-cartao]');
      if (!k) box.append(vazio(T.semCartao));
      else {
        box.append(el('p', 'cartao-final', `${T.cartaoFinal} •••• ${k.final}${k.bandeira ? ' · ' + k.bandeira : ''}`));
        const ul = el('ul', 'lista-simples');
        const linhas: [string, string][] = [[T.situacao, T.situacoes[k.situacao] || k.situacao]];
        if (k.limite) linhas.push([T.limite, valor(k.limite, k.moeda)]);
        if (k.fatura) linhas.push([T.fatura, valor(k.fatura, k.moeda)]);
        if (k.vencimento) linhas.push([T.vencimento, dataC(k.vencimento)]);
        for (const [a, b] of linhas) { const li = el('li'); li.append(el('span', '', a), el('b', '', b)); ul.append(li); }
        box.append(ul);
      }
    }
    window.addEventListener('ctb:financeiro', (e) => render((e as CustomEvent).detail));
  }
</script>

<style>
  .fin h3 { font-size: 1.3rem; font-weight: 500; margin: 1.4rem 0 0.8rem; color: #f0d39c; }
  .fin h4 { margin: 0; font-size: 1rem; font-weight: 600; color: #f3e6d2; }
  .fin :global(.nota) { color: #c9b49a; font-size: 0.84rem; }
  .link { background: none; border: 0; font: inherit; color: #d9ae6b; text-decoration: underline; cursor: pointer; }
  .fin :global(.quadro) { background: rgba(28, 16, 11, 0.28); border: 1px solid rgba(201, 164, 106, 0.32); border-radius: 14px; padding: 1rem 1.1rem; }
  .quadro__topo { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 0.5rem; }
  .saldo { position: relative; overflow: hidden; border-radius: 18px; border: 1px solid rgba(240, 211, 156, 0.45); min-height: 210px; }
  .saldo__fundo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 45%; filter: brightness(0.62) saturate(0.9); }
  .saldo__conteudo { position: relative; padding: 1.3rem 1.4rem; display: flex; flex-direction: column; gap: 0.2rem; background: linear-gradient(90deg, rgba(28, 16, 11, 0.78), rgba(28, 16, 11, 0.2)); min-height: 210px; }
  .saldo__rotulo { color: #e8d6b7; font-size: 0.9rem; }
  .saldo__valor { font-size: clamp(1.8rem, 4vw, 2.4rem); font-weight: 600; color: #f6f0e6; font-variant-numeric: tabular-nums; }
  .saldo__contas { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: auto; padding-top: 1rem; }
  .saldo__contas :global(div) { display: flex; flex-direction: column; gap: 0.1rem; padding: 0.55rem 0.8rem; border-radius: 12px; background: rgba(28, 16, 11, 0.6); border: 1px solid rgba(201, 164, 106, 0.4); }
  .saldo__contas :global(span) { font-size: 0.74rem; color: #c9b49a; }
  .saldo__contas :global(b) { font-size: 0.95rem; color: #f0d39c; font-variant-numeric: tabular-nums; }
  .saldo__contas :global(.saldo__vazio) { font-size: 0.9rem; color: #e8d6b7; }
  .saldo__nota { font-size: 0.76rem; color: #c9b49a; margin-top: 0.4rem; }
  .atalhos { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.7rem; }
  .atalhos button { display: flex; flex-direction: column; align-items: center; gap: 0.45rem; padding: 0.9rem 0.4rem; border-radius: 14px; border: 1px solid rgba(201, 164, 106, 0.32); background: rgba(28, 16, 11, 0.28); color: #f3e6d2; font: inherit; font-size: 0.84rem; cursor: pointer; }
  .atalhos button:hover { border-color: #d9ae6b; }
  .atalhos svg { width: 26px; height: 26px; fill: none; stroke: #d9ae6b; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .duas { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; margin-top: 1.2rem; }
  .real { margin: 0.2rem 0 0; color: #f3e6d2; font-size: 0.92rem; }
  .saldos { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.9rem; }
  .saldos :global(span) { display: block; color: #c9b49a; font-size: 0.84rem; }
  .saldos :global(strong), .fin :global(.grande) { display: block; font-size: 1.6rem; font-weight: 600; color: #f6f0e6; font-variant-numeric: tabular-nums; }
  .fin :global(.vazio), .fin :global(.vazio-li) { color: #e8d6b7; font-style: italic; margin: 0.4rem 0; list-style: none; }
  .mov { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(201, 164, 106, 0.18); }
  .mov :global(li) { display: grid; grid-template-columns: auto 1fr auto; gap: 0.9rem; align-items: center; padding: 0.8rem 0.2rem; border-bottom: 1px solid rgba(201, 164, 106, 0.14); }
  .mov :global(li.vazio-li) { display: block; }
  .mov :global(.mov__seta) { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 50%; border: 1px solid rgba(201, 164, 106, 0.4); color: #d9ae6b; font-weight: 700; }
  .mov :global(.mov__seta[data-t='credito']) { background: rgba(217, 174, 107, 0.18); color: #f0d39c; }
  .mov :global(.mov__desc), .mov :global(.mov__valor) { display: flex; flex-direction: column; color: #f3e6d2; font-size: 0.92rem; overflow-wrap: anywhere; }
  .mov :global(.mov__valor) { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .mov :global(small) { color: #c9b49a; font-size: 0.76rem; }
  .fin :global(.sub) { margin: 1rem 0 0.6rem; color: #f0d39c; font-weight: 500; }
  .fin :global(.carteira) { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .fin :global(.carteira li) { display: grid; grid-template-columns: 9rem 1fr 3.4rem; gap: 0.8rem; align-items: center; color: #f3e6d2; font-size: 0.9rem; }
  .fin :global(.barra) { height: 8px; border-radius: 999px; background: rgba(201, 164, 106, 0.16); overflow: hidden; }
  .fin :global(.barra i) { display: block; height: 100%; border-radius: 999px; background: linear-gradient(90deg, #b9853f, #f0d39c); }
  .fin :global(.carteira b) { text-align: right; color: #f0d39c; font-variant-numeric: tabular-nums; }
  .fin :global(.lista-simples) { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(201, 164, 106, 0.18); }
  .fin :global(.lista-simples li) { display: flex; justify-content: space-between; gap: 1rem; padding: 0.7rem 0.2rem; border-bottom: 1px solid rgba(201, 164, 106, 0.14); color: #f3e6d2; font-size: 0.92rem; }
  .fin :global(.lista-simples b) { color: #f0d39c; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .cartao-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.4rem; align-items: start; }
  .cartao-img { width: 100%; height: auto; border-radius: 16px; border: 1px solid rgba(240, 211, 156, 0.5); box-shadow: 0 20px 40px rgba(28, 16, 11, 0.45); }
  .fin :global(.cartao-final) { margin: 0 0 0.8rem; font-size: 1.1rem; color: #f0d39c; letter-spacing: 0.04em; }
  .ops-acoes { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1rem; }
  .btn-ouro { font: inherit; font-weight: 600; border: 1px solid #f0d39c; border-radius: 999px; padding: 0.7rem 1.4rem; cursor: pointer; color: #24120a; background: linear-gradient(180deg, #f0d39c, #c99550 60%, #a8742f); }
  .btn-linha { display: inline-flex; align-items: center; font-weight: 500; border: 1px solid rgba(201, 164, 106, 0.5); border-radius: 999px; padding: 0.7rem 1.4rem; color: #f3e6d2; text-decoration: none; }
  @media (max-width: 800px) {
    .atalhos { grid-template-columns: repeat(3, 1fr); }
    .duas, .cartao-grid { grid-template-columns: 1fr; }
    .fin :global(.carteira li) { grid-template-columns: 7rem 1fr 3rem; }
    .mov :global(.mov__valor) { white-space: normal; }
  }
</style>
