  opsMinhas: 'My requests', opsNenhuma: 'You have not made any requests yet.', opsSemConta: 'Requests become available once our team has registered your account. Book a conversation to get started.',
  opsMotivo: 'Reason', opsLancada: 'Recorded in your statement',
  opsTipos: { transferencia_local: 'Local transfer (UAE)', transferencia_swift: 'International transfer (SWIFT)', cambio: 'Currency exchange' },
  opsStatus: { recebida: 'Received', em_analise: 'Under review', concluida: 'Completed', recusada: 'Declined' },
  opsErros: { valor_invalido: 'Check the amount (e.g. 8,000.00).', moeda_invalida: 'Choose a currency different from the account currency.', beneficiario_obrigatorio: 'Enter the beneficiary name.', iban_obrigatorio: 'Enter the IBAN or account number.', swift_invalido: 'Check the SWIFT/BIC code (8 or 11 characters).', conta_invalida: 'Choose the account.', tipo_invalido: 'Choose the operation.', limite_operacoes: 'You already have several open requests. Wait for our team to review them.', geral: 'We could not send your request. Please try again.' },
