---
import PageBanner from './PageBanner.astro';
import { client } from '../i18n/client';
import { company } from '../i18n/company';
import { routes, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = client[lang];
const f = c.form;
const t = useTranslations(lang);

const stepIcons = [
  '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M8 9h8"/><path d="M8 13h5"/>',
  '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/><path d="m8.5 11 1.8 1.8 3.2-3.6"/>',
  '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>',
  '<path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.3 1 2.1V17h6v-.2c0-.8.4-1.6 1-2.1A7 7 0 0 0 12 2z"/>',
];
---
<PageBanner
  eyebrow={c.banner.eyebrow} title={c.banner.title} lead={c.banner.lead}
  crumbs={[{ label: t('nav.home'), href: routes.home[lang] }, { label: c.banner.crumb }]}
/>

<!-- Como funciona -->
<section class="steps-sec">
  <div class="container">
    <header class="head">
      <p class="eyebrow">{c.steps.eyebrow}</p>
      <h2>{c.steps.title}</h2>
      <span class="gold-rule gold-rule--center"></span>
    </header>
    <ol class="steps">
      {c.steps.items.map((s, i) => (
        <li>
          <span class="steps__icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={stepIcons[i]} /></span>
          <span class="steps__num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
    <p class="areas-note"><a href={routes.solutions[lang]}>{c.steps.areasNote}</a></p>
  </div>
</section>

<!-- Formulário -->
<section class="form-sec">
  <div class="container form-wrap">
    <div class="form-card">
      <p class="eyebrow">{f.eyebrow}</p>
      <h2>{f.title}</h2>
      <span class="gold-rule"></span>
      <p class="form-intro">{f.intro}</p>

      <form action={company.formEndpoint} method="post" novalidate data-client-form
        data-msg-sending={f.sending} data-msg-success={f.success} data-msg-error={f.error}
        data-msg-invalid={f.invalid} data-msg-rate={f.rateLimit}>
        <input type="hidden" name="form" value="client" />
        <input type="hidden" name="lang" value={lang} />
        <input type="hidden" name="started_at" value="" data-started-at />
        <div class="hp" aria-hidden="true">
          <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <fieldset>
          <label>
            <span>{f.name} *</span>
            <input type="text" name="name" required minlength="3" maxlength="120" autocomplete="name" />
          </label>

          <div class="type">
            <span class="type__label">{f.clientType} *</span>
            <div class="type__options" role="radiogroup">
              <label class="pill"><input type="radio" name="client_type" value="individual" required checked data-type /><span>{f.individual}</span></label>
              <label class="pill"><input type="radio" name="client_type" value="company" required data-type /><span>{f.company}</span></label>
            </div>
          </div>

          <label data-company hidden>
            <span>{f.companyName} *</span>
            <input type="text" name="company" maxlength="160" placeholder={f.companyPlaceholder} autocomplete="organization" />
          </label>

          <div class="row">
            <label>
              <span>{f.country} *</span>
              <input type="text" name="country" required minlength="2" maxlength="80" autocomplete="country-name" />
            </label>
            <label>
              <span>{f.area} *</span>
              <select name="area" required>
                <option value="" disabled selected>{f.areaPlaceholder}</option>
                {f.areas.map((a) => <option value={a}>{a}</option>)}
              </select>
            </label>
          </div>

          <div class="row">
            <label>
              <span>{f.email} *</span>
              <input type="email" name="email" required maxlength="160" autocomplete="email" />
            </label>
            <label>
              <span>{f.phone} *</span>
              <input type="tel" name="phone" required maxlength="25" pattern="^\+?[0-9 ()\-]{7,25}$" placeholder={f.phonePlaceholder} autocomplete="tel" />
            </label>
          </div>

          <label>
            <span>{f.message} *</span>
            <textarea name="message" rows="5" required minlength="10" maxlength="3000"></textarea>
          </label>

          <label class="consent">
            <input type="checkbox" name="consent" value="on" required />
            <span>{f.consent} <a href={routes.privacy[lang]} target="_blank">{f.privacyLink}</a></span>
          </label>

          <div class="actions">
            <button type="submit" class="btn btn--primary" data-submit>
              {f.submit}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
            </button>
            <small>* {f.required}</small>
          </div>
        </fieldset>
        <p class="form-status" role="status" aria-live="polite" hidden data-status></p>
      </form>
    </div>
    <p class="disclaimer">{c.disclaimer}</p>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-client-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const btn = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const started = form.querySelector<HTMLInputElement>('[data-started-at]')!;
    const companyBox = form.querySelector<HTMLElement>('[data-company]')!;
    const companyInput = companyBox.querySelector('input')!;
    started.value = String(Date.now());
    const label = btn.innerHTML;

    const syncType = () => {
      const isCompany = (form.querySelector('[data-type]:checked') as HTMLInputElement | null)?.value === 'company';
      companyBox.hidden = !isCompany;
      companyInput.required = isCompany;
      if (!isCompany) companyInput.value = '';
    };
    form.querySelectorAll('[data-type]').forEach((r) => r.addEventListener('change', syncType));
    syncType();

    const show = (msg: string, kind: 'ok' | 'err') => {
      status.hidden = false; status.textContent = msg; status.dataset.kind = kind;
      status.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      form.querySelectorAll('.is-invalid').forEach((el) => el.classList.remove('is-invalid'));
      if (!form.checkValidity()) {
        form.querySelectorAll<HTMLElement>(':invalid').forEach((el) => el.classList.add('is-invalid'));
        (form.querySelector(':invalid') as HTMLElement | null)?.focus();
        return show(form.dataset.msgInvalid!, 'err');
      }
      btn.disabled = true; btn.textContent = form.dataset.msgSending!;
      try {
        const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
        const r = await fetch(form.action, { method: 'POST', body, headers: { Accept: 'application/json' } });
        const j = await r.json().catch(() => ({}));
        if (r.ok && j.ok) {
          form.reset(); syncType(); started.value = String(Date.now());
          return show(form.dataset.msgSuccess!, 'ok');
        }
        if (r.status === 422 && Array.isArray(j.fields)) {
          j.fields.forEach((n: string) => form.querySelector(`[name="${n}"]`)?.classList.add('is-invalid'));
          return show(form.dataset.msgInvalid!, 'err');
        }
        if (r.status === 429) return show(form.dataset.msgRate!, 'err');
        show(form.dataset.msgError!, 'err');
      } catch {
        show(form.dataset.msgError!, 'err');
      } finally {
        btn.disabled = false; btn.innerHTML = label;
      }
    });
  }
</script>

<style>
  .eyebrow { color: var(--color-cafe); }
  h2 { font-size: clamp(2rem, 3.4vw, 2.9rem); font-weight: 400; line-height: 1.1; margin: 0.8rem 0 0; text-wrap: balance; }
  h3 { font-size: 1.4rem; font-weight: 500; margin: 0 0 0.6rem; }
  .gold-rule { display: block; width: 72px; height: 1px; background: var(--color-gold); margin: 1.5rem 0; }
  .gold-rule--center { margin-inline: auto; }
  .head { text-align: center; max-width: 44rem; margin: 0 auto clamp(2.5rem, 5vw, 4rem); }

  /* Etapas */
  .steps-sec { background: var(--color-espresso); color: var(--color-ivory); padding-block: clamp(4rem, 9vw, 6.5rem); }
  .steps-sec .eyebrow { color: var(--color-gold); }
  .steps-sec h2 { color: var(--color-champagne); }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1.5rem, 3vw, 2.5rem); position: relative; }
  .steps::before { content: ''; position: absolute; top: 40px; left: 12.5%; right: 12.5%; height: 1px; background: var(--color-line); }
  .steps li { position: relative; text-align: center; }
  .steps__icon { position: relative; z-index: 1; display: grid; place-items: center; width: 80px; height: 80px; margin: 0 auto 1.2rem; border-radius: 50%; border: 1px solid var(--color-gold); background: var(--color-espresso); }
  .steps svg { width: 30px; height: 30px; fill: none; stroke: var(--color-champagne); stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
  .steps__num { display: block; font-family: var(--font-display); color: var(--color-gold); letter-spacing: 0.2em; margin-bottom: 0.4rem; }
  .steps h3 { color: var(--color-champagne); }
  .steps p { margin: 0; opacity: 0.82; font-size: 0.95rem; }
  .areas-note { margin: clamp(2.5rem, 5vw, 3.5rem) 0 0; text-align: center; font-size: 0.9rem; }
  .areas-note a { color: var(--color-champagne); text-decoration: underline; text-decoration-color: var(--color-line); text-underline-offset: 4px; }
  .areas-note a:hover { color: var(--color-gold); }

  /* Formulário */
  .form-sec { background: var(--color-ivory); color: var(--color-espresso); padding-block: clamp(4rem, 9vw, 6.5rem); }
  .form-wrap { max-width: 52rem; }
  .form-card { padding: clamp(2rem, 4vw, 3.2rem); background: #fbf8f2; border: 1px solid rgba(98, 72, 58, 0.16); box-shadow: 0 24px 50px rgba(53, 36, 29, 0.08); }
  .form-intro { margin: 0 0 2rem; color: var(--color-cafe); font-size: 0.95rem; }
  fieldset { border: 0; margin: 0; padding: 0; display: grid; gap: 1.1rem; min-width: 0; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
  label { display: flex; flex-direction: column; gap: 0.4rem; }
  label[hidden] { display: none; }
  label > span, .type__label { font-size: 0.8rem; letter-spacing: 0.04em; color: var(--color-cafe); }
  input, select, textarea { font: inherit; font-size: 1rem; color: var(--color-espresso); background: var(--color-ivory); border: 1px solid rgba(98, 72, 58, 0.25); border-radius: 4px; padding: 0.8rem 0.9rem; min-height: 48px; width: 100%; transition: border-color 0.2s ease, box-shadow 0.2s ease; }
  textarea { resize: vertical; min-height: 130px; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--color-gold); box-shadow: 0 0 0 3px rgba(181, 139, 77, 0.2); }
  .type { display: grid; gap: 0.5rem; }
  .type__options { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .pill { flex-direction: row; align-items: center; gap: 0; cursor: pointer; }
  .pill input { position: absolute; opacity: 0; width: 1px; height: 1px; min-height: 0; }
  .pill span { padding: 0.65rem 1.3rem; border: 1px solid rgba(98, 72, 58, 0.3); border-radius: 999px; font-size: 0.92rem; color: var(--color-espresso); letter-spacing: 0; transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease; }
  .pill input:checked + span { background: var(--color-espresso); border-color: var(--color-espresso); color: var(--color-champagne); }
  .pill input:focus-visible + span { box-shadow: 0 0 0 3px rgba(181, 139, 77, 0.35); }
  .consent { flex-direction: row; align-items: flex-start; gap: 0.7rem; }
  .consent input { width: 18px; height: 18px; min-height: 0; margin-top: 3px; accent-color: var(--color-gold); flex: none; }
  .consent span { font-size: 0.85rem; line-height: 1.5; }
  .consent a { color: var(--color-gold-deep, #a8843f); text-decoration: underline; text-underline-offset: 2px; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 0.4rem; }
  .actions small { font-size: 0.75rem; color: var(--color-cafe); }
  .actions .btn:disabled { opacity: 0.7; cursor: wait; transform: none; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .form-status { margin: 1.4rem 0 0; padding: 0.9rem 1.1rem; border-left: 2px solid var(--color-gold); background: rgba(181, 139, 77, 0.12); font-size: 0.92rem; }
  .form-status[data-kind='ok'] { border-left-color: #4f7a52; background: rgba(79, 122, 82, 0.12); }
  .form-status[data-kind='err'] { border-left-color: #a5523a; background: rgba(165, 82, 58, 0.1); }
  :global(.is-invalid) { border-color: #a5523a !important; box-shadow: 0 0 0 3px rgba(165, 82, 58, 0.15) !important; }
  .disclaimer { margin: 2rem 0 0; text-align: center; font-size: 0.82rem; font-style: italic; color: var(--color-cafe); }

  @media (max-width: 1000px) {
    .steps { grid-template-columns: repeat(2, 1fr); row-gap: 3rem; }
    .steps::before { display: none; }
  }
  @media (max-width: 600px) {
    .steps, .row { grid-template-columns: 1fr; }
    .actions .btn { width: 100%; justify-content: center; }
  }
</style>
