    status: { rascunho: 'Draft', enviada: 'Request sent', analise_documental: 'Document review', documentacao_solicitada: 'Additional documents requested', analise_interna: 'Internal review', encaminhada: 'Forwarded to the financial institution', aguardando_instituicao: 'Awaiting the institution', aprovada: 'Approved by the institution', recusada: 'Declined', cancelada: 'Cancelled', concluida: 'Completed' },
