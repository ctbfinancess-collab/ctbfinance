      .botao.pequeno { padding: 0.45rem 1rem; font-size: 0.85rem; }
      .botao.claro { background: #efe6d6; box-shadow: none; border: 1px solid rgba(98, 72, 58, 0.25); }
      .botao.perigo { background: #f2dcd2; color: #8b3a1f; box-shadow: none; border: 1px solid rgba(199, 113, 79, 0.45); }
      .link { background: none; border: 0; font: inherit; font-size: 0.88rem; color: #8a5e2e; text-decoration: underline; cursor: pointer; padding: 0.3rem; }
      .nota { color: var(--color-cafe); font-size: 0.86rem; margin: 0.4rem 0; }
      .nota.ok { color: #3f6b44; }
      .msg { margin: 0.8rem 0; padding: 0.7rem 0.9rem; font-size: 0.9rem; border-left: 3px solid #6f9a72; background: rgba(111, 154, 114, 0.14); }
      .msg[data-tipo='erro'] { border-left-color: #c7714f; background: rgba(199, 113, 79, 0.14); }
      .carregando { text-align: center; margin: 4rem 0; color: var(--color-cafe); }
      .abas { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.2rem; }
      .abas button { font: inherit; font-size: 0.9rem; padding: 0.55rem 1.1rem; border-radius: 999px; border: 1px solid rgba(98, 72, 58, 0.3); background: transparent; color: var(--color-espresso); cursor: pointer; }
      .abas button[aria-selected='true'] { background: var(--color-espresso); color: var(--color-champagne); border-color: var(--color-espresso); }
      .abas b { display: inline-block; min-width: 1.3em; margin-left: 0.3rem; padding: 0 0.4em; border-radius: 999px; background: #c7714f; color: #fff; font-size: 0.75rem; font-weight: 600; }
      .abas b:empty { display: none; }
      .numeros { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 0.9rem; }
      .numero { text-align: left; font: inherit; cursor: pointer; background: #fbf8f2; border: 1px solid rgba(98, 72, 58, 0.16); padding: 1.1rem 1.2rem; display: flex; flex-direction: column; gap: 0.3rem; }
      .numero strong { font-family: var(--font-body); font-size: 2rem; font-weight: 500; line-height: 1; font-variant-numeric: lining-nums tabular-nums; color: var(--color-espresso); }
      .numero span { font-size: 0.85rem; color: var(--color-cafe); }
      .numero.alerta { border-color: rgba(199, 113, 79, 0.55); background: #fbefe9; }
      .convite h2 { font-size: 1.4rem; margin: 0 0 0.8rem; }
      .linha { display: grid; grid-template-columns: 1fr 1.3fr 0.8fr auto; gap: 0.8rem; align-items: end; }
      .busca { margin: 1.2rem 0 0.6rem; }
