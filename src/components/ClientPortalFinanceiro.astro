    campos: { instrumento: 'instrumento', moeda: 'moeda', valor: 'valor', beneficiarioNome: 'nome do beneficiário', beneficiarioPais: 'país do beneficiário', finalidade: 'finalidade', ordenanteNome: 'nome do ordenante' },
    erros: { campos_invalidos: 'Confira as informações (valor ex.: 1.000.000,00; data válida).', limite_instrumentos: 'Você já tem várias solicitações em aberto. Aguarde a nossa análise.', nao_editavel: 'Esta solicitação não pode mais ser editada.', ja_enviada: 'Esta solicitação já foi enviada.', nao_cancelavel: 'Esta solicitação não pode mais ser cancelada.', tipo_nao_aceito: 'Somente arquivos PDF, JPG ou PNG.', muito_grande: 'Arquivo maior que 10 MB.', conteudo_nao_confere: 'O conteúdo do arquivo não confere com o tipo.', cota: 'Limite diário de envios atingido.', limite_mensagens: 'Limite diário de mensagens atingido.', geral: 'Não foi possível concluir. Tente de novo.' },
    status: { rascunho: 'Rascunho', enviada: 'Solicitação enviada', analise_documental: 'Em análise documental', documentacao_solicitada: 'Documentação complementar solicitada', analise_interna: 'Em análise interna', encaminhada: 'Encaminhada à instituição financeira', aguardando_instituicao: 'Aguardando resposta da instituição', aprovada: 'Aprovada pela instituição', recusada: 'Recusada', cancelada: 'Cancelada', concluida: 'Concluída' },
    garantiasLista: { SBLC: 'Standby Letter of Credit', LC: 'Letter of Credit', DLC: 'Documentary Letter of Credit', BG: 'Bank Guarantee', PBG: 'Performance Bank Guarantee', APG: 'Advance Payment Guarantee', BB: 'Bid Bond', LG: 'Letter of Guarantee', FC: 'Financial Guarantee' }, declaracoesLista: { RWA: 'Ready, Willing and Able', BCL: 'Bank Comfort Letter', POF: 'Proof of Funds' },
  },
};
const I = T.inst;
---
<div class="fin" data-fin data-lang={lang} data-t={JSON.stringify(T)}>
  <!-- Início -->
  <section data-panel="inicio">
    <div class="saldo">
      <img src="/video/hero-1-poster.jpg" alt="" class="saldo__fundo" loading="lazy" />
      <div class="saldo__conteudo">
        <span class="saldo__rotulo">{T.saldo}</span>
        <strong class="saldo__valor" data-fin-saldo>—</strong>
        <div class="saldo__contas" data-fin-contas-resumo></div>
        <span class="saldo__nota" data-fin-atualizado></span>
      </div>
    </div>
    <h3>{T.atalhos}</h3>
    <div class="atalhos">
      <button type="button" data-ir-aba="conta"><svg viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6z"/><path d="M9 12h6M9 16h6"/></svg>{T.extrato}</button>
      <button type="button" data-ir-aba="operacoes" data-op-pre="transferencia_swift"><svg viewBox="0 0 24 24"><path d="M4 8h14l-3-3M20 16H6l3 3"/></svg>{T.transferencias}</button>
      <button type="button" data-ir-aba="investimentos"><svg viewBox="0 0 24 24"><path d="M4 20h16M6 16v-4M10 16V9M14 16v-6M18 16V6"/></svg>{T.investimentos}</button>
      <button type="button" data-ir-aba="operacoes" data-op-pre="cambio"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M14.5 9.5c-.5-1-1.5-1.5-2.5-1.5-1.4 0-2.5.8-2.5 2s1.1 1.7 2.5 2 2.5.8 2.5 2-1.1 2-2.5 2c-1 0-2-.5-2.5-1.5M12 6v12"/></svg>{T.cambio}</button>
      <button type="button" data-ir-aba="cartoes"><svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/></svg>{T.cartoes}</button>
    </div>
    <div class="duas">
      <div class="quadro"><div class="quadro__topo"><h4>{T.proxAg}</h4><button type="button" class="link" data-ir-aba="appointments">{T.verTodos}</button></div><p class="real" data-inicio-agenda>—</p></div>
      <div class="quadro"><div class="quadro__topo"><h4>{T.docs}</h4><button type="button" class="link" data-ir-aba="documents">{T.abrir}</button></div><p class="real" data-inicio-docs>—</p></div>
    </div>
  </section>

  <!-- Conta: saldos e extrato -->
  <section data-panel="conta" hidden>
    <h3>{T.contas}</h3>
    <div class="saldos" data-fin-contas></div>
    <h3>{T.movimentacoes}</h3>
    <ul class="mov" data-fin-mov></ul>
  </section>

  <!-- Investimentos -->
  <section data-panel="investimentos" hidden>
    <div data-fin-inv></div>
  </section>

  <!-- Cartões -->
  <section data-panel="cartoes" hidden>
    <div class="cartao-grid">
      <img src="/brand/area/cartao-ctb.jpg" alt="CTB Finances" class="cartao-img" loading="lazy" />
      <div data-fin-cartao></div>
    </div>
  </section>

  <!-- Operações -->
  <section data-panel="operacoes" hidden>
    <!-- Instrumentos financeiros: só solicitação e acompanhamento (nada é emitido pelo sistema) -->
    <div class="inst" data-inst>
      <h3>{I.titulo}</h3>
      <p class="real">{I.intro}</p>
      <p class="inst-aviso" data-inst-aviso>{I.aviso}</p>
      <button type="button" class="btn-ouro" data-inst-nova>{I.nova}</button>
      <form class="op-form inst-form" data-inst-form hidden novalidate>
        <h4 data-inst-form-titulo>{I.nova}</h4>
        <input type="hidden" name="id" />
        <div class="op-grade">
          <label class="largo"><span>{I.instrumento}</span><select name="instrumento">
            <optgroup label={I.garantias}>{Object.entries(I.garantiasLista).map(([k, v]) => <option value={k}>{k} — {v}</option>)}</optgroup>
            <optgroup label={I.declaracoes}>{Object.entries(I.declaracoesLista).map(([k, v]) => <option value={k}>{k} — {v}</option>)}</optgroup>
          </select></label>
          <label><span>{I.moeda}</span><select name="moeda">{['USD', 'EUR', 'AED', 'GBP'].map((m) => <option value={m}>{m}</option>)}</select></label>
          <label><span>{I.valor}</span><input name="valor" inputmode="decimal" autocomplete="off" placeholder={en ? 'e.g. 1,000,000.00' : 'ex.: 1.000.000,00'} /></label>
          <label><span>{I.validade}</span><input name="validade" type="date" /></label>
        </div>
        <fieldset class="op-benef">
          <legend>{I.benef}</legend>
          <div class="op-grade">
            <label class="largo"><span>{I.nome}</span><input name="bNome" maxlength="160" autocomplete="off" /></label>
            <label><span>{I.pais}</span><input name="bPais" maxlength="80" autocomplete="off" /></label>
            <label class="largo"><span>{I.endereco}</span><input name="bEndereco" maxlength="200" autocomplete="off" /></label>
            <label><span>{I.banco}</span><input name="bBanco" maxlength="160" autocomplete="off" /></label>
          </div>
        </fieldset>
        <fieldset class="op-benef">
          <legend>{I.ordenante}</legend>
          <div class="op-grade">
            <label class="largo"><span>{I.ordNome}</span><input name="oNome" maxlength="160" autocomplete="off" /></label>
            <label><span>{I.ordId}</span><input name="oId" maxlength="80" autocomplete="off" /></label>
          </div>
        </fieldset>
        <label class="op-obs"><span>{I.finalidade}</span><textarea name="finalidade" maxlength="1000" rows="2"></textarea></label>
        <div class="op-tipos op-sugestoes" data-sug-finalidade>{I.sugFinalidade.map((t: string) => <button type="button" aria-pressed="false" data-sug={t}>{t}</button>)}</div>
        <label class="op-obs"><span>{I.operacao}</span><textarea name="operacaoSubjacente" maxlength="1000" rows="2"></textarea></label>
        <div class="op-grade">
          <label><span>{I.emissor}</span><input name="bancoEmissor" maxlength="160" autocomplete="off" /></label>
          <label><span>{I.avisador}</span><input name="bancoAvisador" maxlength="160" autocomplete="off" /></label>
          <label class="largo"><span>{I.contrato}</span><input name="contratoRef" maxlength="160" autocomplete="off" /></label>
        </div>
        <label class="op-obs"><span>{I.obs}</span><textarea name="observacoes" maxlength="2000" rows="2"></textarea></label>
        <p class="inst-aviso pequeno">{I.aviso}</p>
        <div class="inst-botoes">
          <button type="button" class="btn-linha" data-inst-salvar>{I.salvar}</button>
          <button type="submit" class="btn-ouro" data-inst-enviar>{I.enviar}</button>
          <button type="button" class="link" data-inst-fechar>{I.fechar}</button>
        </div>
        <p class="op-msg" data-inst-msg role="status" aria-live="polite" hidden></p>
      </form>
      <p class="op-msg" data-inst-msg-lista role="status" aria-live="polite" hidden></p>
      <h4 class="sub">{I.minhas}</h4>
      <ul class="op-lista inst-lista" data-inst-lista></ul>
    </div>
    <div class="transf" data-transf>
      <h3>{T.opsTitulo}</h3>
      <p class="real">{T.opsIntro}</p>
      <p class="vazio" data-op-semconta hidden>{T.opsSemConta}</p>
      <form class="op-form" data-op-form hidden novalidate>
        <h4>{T.opsNova}</h4>
        <div class="op-tipos" role="radiogroup" aria-label={T.opsTipo}>
          {Object.entries(T.opsTipos).map(([k, v], i) => <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-op-tipo={k}>{v}</button>)}
        </div>
        <div class="op-grade">
          <label><span>{T.opsConta}</span><select name="contaId" data-op-conta></select></label>
          <label><span>{T.opsValor}</span><input name="valor" inputmode="decimal" autocomplete="off" placeholder={en ? 'e.g. 8,000.00' : 'ex.: 8.000,00'} /></label>
          <label data-op-cambio hidden><span>{T.opsPara}</span><select name="moedaDestino">{['AED', 'USD', 'EUR', 'GBP', 'BRL'].map((m) => <option value={m}>{m}</option>)}</select></label>
        </div>
        <fieldset class="op-benef" data-op-benef>
          <legend>{T.opsBenef}</legend>
          <div class="op-grade">
            <label class="largo"><span>{T.opsNome}</span><input name="nome" maxlength="120" autocomplete="off" /></label>
            <label><span>{T.opsBanco}</span><input name="banco" maxlength="120" autocomplete="off" /></label>
            <label class="largo"><span>{T.opsIban}</span><input name="iban" maxlength="50" autocomplete="off" /></label>
            <label data-op-swift><span>{T.opsSwift}</span><input name="swift" maxlength="11" autocomplete="off" /></label>
            <label><span>{T.opsPais}</span><input name="pais" maxlength="60" autocomplete="off" /></label>
          </div>
        </fieldset>
        <label class="op-obs"><span>{T.opsObs}</span><textarea name="observacao" maxlength="500" rows="2"></textarea></label>
        <button type="submit" class="btn-ouro" data-op-enviar>{T.opsEnviar}</button>
        <p class="op-msg" data-op-msg role="status" aria-live="polite" hidden></p>
      </form>
      <h4 class="sub">{T.opsMinhas}</h4>
      <ul class="op-lista" data-op-lista></ul>
    </div>
    <div class="ops-acoes">
      <button type="button" class="btn-ouro" data-ir-aba="appointments">{T.agendar}</button>
      <a class="btn-linha" href={routes.contact[lang]}>{T.falar}</a>
    </div>
  </section>
</div>

<script>
  type Conta = { id: string; tipo: string; moeda: string; saldo: string; atualizado_em: string };
  const raiz = document.querySelector<HTMLElement>('[data-fin]');
  if (raiz && !raiz.dataset.pronto) {
    raiz.dataset.pronto = '1';
    // sugestões de finalidade: um clique preenche o campo (dá para completar o texto depois)
    raiz.querySelectorAll<HTMLElement>('[data-sug-finalidade]').forEach((box) => box.addEventListener('click', (ev) => {
      const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('button[data-sug]'); if (!b) return;
      const ta = box.previousElementSibling?.querySelector('textarea') as HTMLTextAreaElement | null; if (!ta) return;
      ta.value = b.dataset.sug!; box.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      ta.dispatchEvent(new Event('input', { bubbles: true })); ta.focus();
    }));
    const T = JSON.parse(raiz.dataset.t!);
    const en = raiz.dataset.lang === 'en';
    const loc = en ? 'en-GB' : 'pt-BR';
    const $ = (s: string) => raiz.querySelector<HTMLElement>(s)!;
    const el = (tag: string, cls = '', txt?: string) => { const e = document.createElement(tag); if (cls) e.className = cls; if (txt !== undefined) e.textContent = txt; return e; };
    // centavos (texto) → "AED 28.750,00"
    const valor = (c: string | number | bigint, moeda: string) => {
      const n = BigInt(c); const neg = n < 0n; const a = neg ? -n : n;
      const inteiro = (a / 100n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, en ? ',' : '.');
      return `${neg ? '− ' : ''}${moeda} ${inteiro}${en ? '.' : ','}${(a % 100n).toString().padStart(2, '0')}`;
    };
    const dataC = (s: string) => new Date(`${s}T12:00:00Z`).toLocaleDateString(loc, { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
    const vazio = (txt: string) => el('p', 'vazio', txt);

    function render(d: any | null) {
      // limpa sempre (troca de sessão nunca mostra dados de outra pessoa)
      ['[data-fin-contas-resumo]', '[data-fin-contas]', '[data-fin-mov]', '[data-fin-inv]', '[data-fin-cartao]'].forEach((s) => $(s).replaceChildren());
      $('[data-fin-saldo]').textContent = '—'; $('[data-fin-atualizado]').textContent = '';
      if (!d) return;
      const contas: Conta[] = d.contas || [];
      // Início: saldo principal = conta digital em AED (ou a primeira conta)
      const principal = contas.find((c) => c.tipo === 'digital' && c.moeda === 'AED') || contas[0];
      $('[data-fin-saldo]').textContent = principal ? valor(principal.saldo, principal.moeda) : '—';
      if (!contas.length) $('[data-fin-contas-resumo]').append(el('span', 'saldo__vazio', T.semDados));
      for (const c of contas) { const b = el('div'); b.append(el('span', '', T.tipos[c.tipo] || c.tipo), el('b', '', valor(c.saldo, c.moeda))); $('[data-fin-contas-resumo]').append(b); }
      if (d.atualizadoEm) $('[data-fin-atualizado]').textContent = `${T.atualizado} ${new Date(d.atualizadoEm).toLocaleDateString(loc, { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'Asia/Dubai' })}`;
      // Conta
      if (!contas.length) $('[data-fin-contas]').append(vazio(T.semDados));
      for (const c of contas) { const q = el('div', 'quadro'); q.append(el('span', '', `${T.tipos[c.tipo] || c.tipo} · ${c.moeda}`), el('strong', '', valor(c.saldo, c.moeda))); $('[data-fin-contas]').append(q); }
      const movs = d.movimentos || [];
      if (!movs.length) $('[data-fin-mov]').append(Object.assign(el('li', 'vazio-li'), { textContent: T.semMov }));
      for (const m of movs) {
        const cred = BigInt(m.valor) > 0n;
        const li = el('li');
        const seta = el('span', 'mov__seta', cred ? '↓' : '↑'); seta.dataset.t = cred ? 'credito' : 'debito';
        const desc = el('span', 'mov__desc', m.descricao); desc.append(el('small', '', `${dataC(m.data)} · ${T.tipos[m.conta_tipo] || ''}`));
        const v = el('span', 'mov__valor', `${cred ? '+ ' : ''}${valor(m.valor, m.moeda)}`); v.append(el('small', '', cred ? T.credito : T.debito));
        li.append(seta, desc, v); $('[data-fin-mov]').append(li);
      }
      // Investimentos: total por moeda e distribuição por classe dentro de cada moeda
      const pos = d.posicoes || [];
      const inv = $('[data-fin-inv]');
      if (!pos.length) inv.append(vazio(T.semInv));
      const porMoeda = new Map<string, any[]>(); for (const p of pos) porMoeda.set(p.moeda, [...(porMoeda.get(p.moeda) || []), p]);
      for (const [moeda, lista] of porMoeda) {
        const total = lista.reduce((s: bigint, p: any) => s + BigInt(p.valor), 0n);
        const q = el('div', 'quadro'); q.append(el('span', 'nota', `${T.patrimonio} · ${moeda}`), el('strong', 'grande', valor(total, moeda)));
        q.append(el('h4', 'sub', T.carteira));
        const ul = el('ul', 'carteira');
        const porClasse = new Map<string, bigint>(); for (const p of lista) porClasse.set(p.classe, (porClasse.get(p.classe) || 0n) + BigInt(p.valor));
        for (const [classe, v] of porClasse) {
          const pct = total > 0n ? Number((v * 1000n) / total) / 10 : 0;
          const li = el('li'); const barra = el('span', 'barra'); const i = el('i'); i.style.width = `${pct}%`; barra.append(i);
          li.append(el('span', '', T.classes[classe] || classe), barra, el('b', '', `${pct.toLocaleString(loc, { maximumFractionDigits: 1 })}%`)); ul.append(li);
        }
        q.append(ul, el('h4', 'sub', T.posicoes));
        const lp = el('ul', 'lista-simples');
        for (const p of lista) { const li = el('li'); li.append(el('span', '', `${p.descricao} · ${T.classes[p.classe] || p.classe}`), el('b', '', valor(p.valor, p.moeda))); lp.append(li); }
        q.append(lp); inv.append(q);
      }
      // Cartão
      const k = d.cartao; const box = $('[data-fin-cartao]');
      if (!k) box.append(vazio(T.semCartao));
      else {
        box.append(el('p', 'cartao-final', `${T.cartaoFinal} •••• ${k.final}${k.bandeira ? ' · ' + k.bandeira : ''}`));
        const ul = el('ul', 'lista-simples');
        const linhas: [string, string][] = [[T.situacao, T.situacoes[k.situacao] || k.situacao]];
        if (k.limite) linhas.push([T.limite, valor(k.limite, k.moeda)]);
        if (k.fatura) linhas.push([T.fatura, valor(k.fatura, k.moeda)]);
        if (k.vencimento) linhas.push([T.vencimento, dataC(k.vencimento)]);
        for (const [a, b] of linhas) { const li = el('li'); li.append(el('span', '', a), el('b', '', b)); ul.append(li); }
        box.append(ul);
      }
    }
    // ---- Operações (solicitações; nada é executado sem a equipe)
    const form = raiz.querySelector<HTMLFormElement>('[data-op-form]')!;
    const lista = $('[data-op-lista]');
    const msg = $('[data-op-msg]');
    let geracao = 0; let tipoOp = 'transferencia_local'; let contasAtuais: Conta[] = [];
    const escolherTipo = (t: string) => {
      tipoOp = t;
      form.querySelectorAll<HTMLElement>('[data-op-tipo]').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.opTipo === t)));
      $('[data-op-cambio]').hidden = t !== 'cambio';
      $('[data-op-benef]').hidden = t === 'cambio';
      $('[data-op-swift]').hidden = t !== 'transferencia_swift';
      ajustarDestino();
    };
    const ajustarDestino = () => {
      const c = contasAtuais.find((k) => k.id === (form.elements.namedItem('contaId') as HTMLSelectElement).value);
      const sel = form.elements.namedItem('moedaDestino') as HTMLSelectElement;
      [...sel.options].forEach((o) => (o.disabled = !!c && o.value === c.moeda));
      if (sel.selectedOptions[0]?.disabled) sel.value = [...sel.options].find((o) => !o.disabled)!.value;
    };
    form.querySelectorAll<HTMLElement>('[data-op-tipo]').forEach((b) => b.addEventListener('click', () => escolherTipo(b.dataset.opTipo!)));
    form.elements.namedItem('contaId')!.addEventListener('change', ajustarDestino);
    document.querySelectorAll<HTMLElement>('[data-op-pre]').forEach((b) => b.addEventListener('click', () => escolherTipo(b.dataset.opPre!)));
    const aviso = (t: string, tipo: 'ok' | 'erro') => { msg.hidden = false; msg.textContent = t; msg.dataset.tipo = tipo; };
    function desenharLista(ops: any[]) {
      lista.replaceChildren();
      if (!ops.length) { lista.append(Object.assign(el('li', 'vazio-li'), { textContent: T.opsNenhuma })); return; }
      for (const o of ops) {
        const li = el('li');
        const topo = el('div', 'op-topo');
        const st = el('span', 'op-status', T.opsStatus[o.status] || o.status); st.dataset.s = o.status;
        topo.append(el('strong', '', T.opsTipos[o.tipo] || o.tipo), st);
        const det = [valor(o.valor, o.moeda) + (o.moeda_destino ? ` → ${o.moeda_destino}` : ''), o.conta_tipo ? T.tipos[o.conta_tipo] || '' : '', new Date(o.criado_em).toLocaleDateString(loc, { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'Asia/Dubai' })].filter(Boolean).join(' · ');
        li.append(topo, el('span', 'op-det', det));
        if (o.beneficiario && o.beneficiario.nome) li.append(el('span', 'op-det', `${T.opsBenef}: ${o.beneficiario.nome}${o.beneficiario.banco ? ' · ' + o.beneficiario.banco : ''}`));
        if (o.status === 'recusada' && o.motivo) li.append(el('span', 'op-motivo', `${T.opsMotivo}: ${o.motivo}`));
        lista.append(li);
      }
    }
    async function carregarOps(g: number) {
      try {
        const r = await fetch('/api/cliente/operacoes', { credentials: 'same-origin' });
        if (!r.ok || g !== geracao) return;
        const d = await r.json(); if (g === geracao) desenharLista(d.operacoes || []);
      } catch {}
    }
    function prepararOps(d: any | null) {
      const g = ++geracao;
      lista.replaceChildren(); msg.hidden = true; form.reset(); escolherTipo('transferencia_local');
      contasAtuais = d ? d.contas || [] : [];
      const sel = form.elements.namedItem('contaId') as HTMLSelectElement;
      sel.replaceChildren(...contasAtuais.map((c) => Object.assign(document.createElement('option'), { value: c.id, textContent: `${T.tipos[c.tipo] || c.tipo} · ${c.moeda} · ${valor(c.saldo, c.moeda)}` })));
      form.hidden = !contasAtuais.length; $('[data-op-semconta]').hidden = !d || !!contasAtuais.length;
      ajustarDestino();
      if (d) carregarOps(g);
    }
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(form); const g = geracao;
      const corpo: any = { tipo: tipoOp, contaId: f.get('contaId'), valor: String(f.get('valor') || '').trim(), observacao: String(f.get('observacao') || '') };
      if (tipoOp === 'cambio') corpo.moedaDestino = f.get('moedaDestino');
      else corpo.beneficiario = { nome: f.get('nome'), banco: f.get('banco'), iban: f.get('iban'), swift: tipoOp === 'transferencia_swift' ? f.get('swift') : '', pais: f.get('pais') };
      if (!corpo.valor) return aviso(T.opsErros.valor_invalido, 'erro');
      const btn = $('[data-op-enviar]') as HTMLButtonElement; btn.disabled = true; btn.textContent = T.opsEnviando;
      try {
        const r = await fetch('/api/cliente/operacoes', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(corpo) });
        const d = await r.json().catch(() => ({}));
        if (g !== geracao) return;
        if (r.status === 201) { form.reset(); escolherTipo(tipoOp); aviso(T.opsOk, 'ok'); carregarOps(g); }
        else aviso(T.opsErros[d.erro] || T.opsErros.geral, 'erro');
      } catch { aviso(T.opsErros.geral, 'erro'); }
      finally { btn.disabled = false; btn.textContent = T.opsEnviar; }
    });

    // ---- Instrumentos financeiros (só solicitação e acompanhamento)
    const I = T.inst;
    const fi = raiz.querySelector<HTMLFormElement>('[data-inst-form]')!;
    const listaI = $('[data-inst-lista]');
    const msgI = $('[data-inst-msg]'); const msgL = $('[data-inst-msg-lista]');
    const FINAIS_I = ['recusada', 'cancelada', 'concluida'];
    let geracaoI = 0;
    const avisoI = (box: HTMLElement, t: string, tipo: 'ok' | 'erro') => { box.hidden = false; box.textContent = t; box.dataset.tipo = tipo; };
    const campo = (n: string) => fi.elements.namedItem(n) as HTMLInputElement;
    const textoValor = (c: string | null) => { if (!c) return ''; const n = BigInt(c); return `${(n / 100n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, en ? ',' : '.')}${en ? '.' : ','}${(n % 100n).toString().padStart(2, '0')}`; };
    const nomeInst = (k: string) => `${k} — ${I.garantiasLista[k] || I.declaracoesLista[k] || ''}`;
    const quando = (s: string) => new Date(s).toLocaleString(loc, { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Dubai' });
    const api = async (metodo: string, rota: string, corpo?: any) => {
      const r = await fetch('/api/cliente/instrumentos' + rota, { method: metodo, credentials: 'same-origin', headers: corpo !== undefined ? { 'Content-Type': 'application/json' } : {}, body: corpo !== undefined ? JSON.stringify(corpo) : undefined });
      return { status: r.status, d: await r.json().catch(() => ({})) };
    };
    const erroI = (d: any) => d.erro === 'campos_obrigatorios' ? `${I.faltam} ${(d.campos || []).map((c: string) => I.campos[c] || c).join(', ')}.` : (I.erros[d.erro] || I.erros.geral);
    function abrirForm(s: any | null) {
      fi.reset(); msgI.hidden = true; fi.hidden = false;
      campo('id').value = s ? s.id : '';
      $('[data-inst-form-titulo]').textContent = s ? `${I.editar}${s.referencia ? ' · ' + s.referencia : ''}` : I.nova;
      (campo('instrumento') as unknown as HTMLSelectElement).disabled = !!(s && s.status !== 'rascunho');
      ($('[data-inst-enviar]') as HTMLButtonElement).textContent = s && s.status === 'documentacao_solicitada' ? I.reenviar : I.enviar;
      if (s) {
        campo('instrumento').value = s.instrumento; campo('moeda').value = s.moeda; campo('valor').value = textoValor(s.valor); campo('validade').value = s.validade || '';
        const b = s.beneficiario || {}; campo('bNome').value = b.nome || ''; campo('bPais').value = b.pais || ''; campo('bEndereco').value = b.endereco || ''; campo('bBanco').value = b.banco || '';
        const o = s.ordenante || {}; campo('oNome').value = o.nome || ''; campo('oId').value = o.identificacao || '';
        for (const [n, k] of [['finalidade', 'finalidade'], ['operacaoSubjacente', 'operacao_subjacente'], ['bancoEmissor', 'banco_emissor'], ['bancoAvisador', 'banco_avisador'], ['contratoRef', 'contrato_ref'], ['observacoes', 'observacoes']]) campo(n).value = s[k] || '';
      }
      fi.scrollIntoView({ block: 'start', behavior: 'smooth' });
    }
    const dadosForm = () => {
      const v = (n: string) => campo(n).value;
      const d: any = { moeda: v('moeda'), valor: v('valor').trim(), validade: v('validade'), beneficiario: { nome: v('bNome'), pais: v('bPais'), endereco: v('bEndereco'), banco: v('bBanco') },
        ordenante: { nome: v('oNome'), identificacao: v('oId') }, finalidade: v('finalidade'), operacaoSubjacente: v('operacaoSubjacente'), bancoEmissor: v('bancoEmissor'), bancoAvisador: v('bancoAvisador'), contratoRef: v('contratoRef'), observacoes: v('observacoes') };
      if (!(campo('instrumento') as unknown as HTMLSelectElement).disabled) d.instrumento = v('instrumento');
      return d;
    };
    async function salvarForm(): Promise<string | null> {
      const id = campo('id').value;
      const r = id ? await api('PUT', '/' + id, dadosForm()) : await api('POST', '', dadosForm());
      if (r.status !== 200 && r.status !== 201) { avisoI(msgI, erroI(r.d), 'erro'); return null; }
      if (!id) campo('id').value = r.d.solicitacao.id;
      return campo('id').value;
    }
    $('[data-inst-nova]').addEventListener('click', () => abrirForm(null));
    $('[data-inst-fechar]').addEventListener('click', () => { fi.hidden = true; });
    $('[data-inst-salvar]').addEventListener('click', async () => { const g = geracaoI; const id = await salvarForm(); if (g !== geracaoI) return; if (id) { avisoI(msgI, I.salvo, 'ok'); carregarInst(g); } });
    fi.addEventListener('submit', async (e) => {
      e.preventDefault(); const g = geracaoI;
      const btn = $('[data-inst-enviar]') as HTMLButtonElement; btn.disabled = true;
      try {
        const id = await salvarForm(); if (!id || g !== geracaoI) return;
        const r = await api('POST', `/${id}/enviar`);
        if (g !== geracaoI) return;
        if (r.status !== 200) { avisoI(msgI, erroI(r.d), 'erro'); carregarInst(g); return; }
        fi.hidden = true; avisoI(msgL, r.d.status === 'enviada' ? `${I.enviado} ${r.d.referencia}` : I.reenviado, 'ok'); carregarInst(g);
      } catch { avisoI(msgI, I.erros.geral, 'erro'); }
      finally { btn.disabled = false; }
    });
    function desenharInst(sols: any[]) {
      listaI.replaceChildren();
      if (!sols.length) { listaI.append(Object.assign(el('li', 'vazio-li'), { textContent: I.nenhuma })); return; }
      for (const s of sols) {
        const li = el('li'); li.dataset.instId = s.id;
        const topo = el('div', 'op-topo');
        const st = el('span', 'op-status', I.status[s.status] || s.status); st.dataset.s = s.status;
        topo.append(el('strong', '', `${nomeInst(s.instrumento)}`), st);
        li.append(topo, el('span', 'op-det', [s.referencia || I.rascunho, s.valor ? valor(s.valor, s.moeda) : `${s.moeda} · ${I.aDefinir}`, s.beneficiario?.nome ? `${I.benef}: ${s.beneficiario.nome}${s.beneficiario.pais ? ' (' + s.beneficiario.pais + ')' : ''}` : ''].filter(Boolean).join(' · ')));
        // último pedido/mensagem da equipe em destaque
        const ultEq = [...(s.eventos || [])].reverse().find((e: any) => e.por_equipe && e.texto);
        if (ultEq && s.status !== 'concluida') li.append(el('span', 'op-motivo', `${I.equipe}: ${ultEq.texto}`));
        const acoes = el('div', 'inst-acoes');
        if (s.status === 'rascunho' || s.status === 'documentacao_solicitada') { const b = el('button', 'link', I.editar) as HTMLButtonElement; b.type = 'button'; b.dataset.instEditar = s.id; b.onclick = () => abrirForm(s); acoes.append(b); }
        if (!FINAIS_I.includes(s.status)) {
          const lab = el('label', 'link inst-anexar', I.anexar); const inp = document.createElement('input'); inp.type = 'file'; inp.accept = 'application/pdf,image/jpeg,image/png'; inp.hidden = true; inp.dataset.instAnexo = s.id;
          inp.onchange = async () => { const f = inp.files?.[0]; if (!f) return; const g = geracaoI;
            try { const r = await fetch(`/api/cliente/instrumentos/${s.id}/anexos`, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': f.type || 'application/octet-stream', 'X-Nome-Arquivo': encodeURIComponent(f.name) }, body: f });
              const d = await r.json().catch(() => ({})); if (g !== geracaoI) return;
              if (r.status === 201) { avisoI(msgL, I.anexado, 'ok'); carregarInst(g); } else avisoI(msgL, I.erros[d.erro] || (r.status === 422 ? I.erros.conteudo_nao_confere : I.erros.geral), 'erro');
            } catch { avisoI(msgL, I.erros.geral, 'erro'); } };
          lab.append(inp); acoes.append(lab);
        }
        if (!FINAIS_I.includes(s.status) && s.status !== 'aprovada') { const b = el('button', 'link', I.cancelar) as HTMLButtonElement; b.type = 'button'; b.onclick = async () => { if (!confirm(I.cancelarConf)) return; const g = geracaoI; const r = await api('POST', `/${s.id}/cancelar`, {}); if (g !== geracaoI) return; avisoI(msgL, r.status === 200 ? I.cancelada : erroI(r.d), r.status === 200 ? 'ok' : 'erro'); carregarInst(g); }; acoes.append(b); }
        li.append(acoes);
        const det = el('details', 'inst-hist') as HTMLDetailsElement; det.append(el('summary', '', `${I.historico} (${(s.eventos || []).length})`));
        const ul = el('ul', 'inst-eventos');
        for (const e of s.eventos || []) {
          const t = e.tipo === 'status' || e.tipo === 'pedido_documento' ? `${I.status[e.status_para] || e.status_para}${e.texto ? ' — ' + e.texto : ''}` : e.texto || '';
          const x = el('li'); x.append(el('small', '', `${quando(e.em)} · ${e.por_equipe ? I.equipe : I.voce}`), el('span', '', t)); ul.append(x);
        }
        det.append(ul);
        if ((s.anexos || []).length) {
          det.append(el('h5', '', I.anexos)); const ua = el('ul', 'inst-eventos');
          for (const a of s.anexos) { const x = el('li'); const ln = el('a', '', a.nome) as HTMLAnchorElement; ln.href = `/api/cliente/documentos/${a.id}/arquivo`; x.append(ln); ua.append(x); }
          det.append(ua);
        }
        if (s.status !== 'rascunho' && !FINAIS_I.includes(s.status)) {
          const fm = el('form', 'inst-msg') as HTMLFormElement; const ta = document.createElement('textarea'); ta.maxLength = 2000; ta.rows = 2; ta.setAttribute('aria-label', I.mensagem); ta.placeholder = I.mensagem;
          const bt = el('button', 'btn-linha', I.enviarMsg) as HTMLButtonElement; bt.type = 'submit';
