---
import ImageSlot from '../ImageSlot.astro';
import Button from '../Button.astro';
import { routes } from '../../i18n/utils';
import { home } from '../../i18n/home';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = home[lang];
const roman = ['I', 'II', 'III', 'IV'];
---
<!-- 1 · Visão global (claro) -->
<section id="sobre" class="sec sec--light">
  <div class="container about">
    <div class="about__text reveal">
      <p class="eyebrow">{c.about.eyebrow}</p>
      <h2>{c.about.title}</h2>
      <span class="gold-rule"></span>
      <p class="lead">{c.about.lead}</p>
      <p>{c.about.body}</p>
    </div>
    <div class="about__media reveal">
      <span class="about__frame" aria-hidden="true"></span>
      <ImageSlot label={c.about.image} alt={c.about.image} ratio="4 / 5"
        src="/brand/sec-sobre.jpg" srcSmall="/brand/sec-sobre-900.jpg" position="18% 50%" />
    </div>
  </div>
</section>

<!-- 2 · Áreas de atuação (escuro) -->
<section id="solucoes" class="sec sec--dark">
  <div class="container">
    <header class="sec__head reveal">
      <p class="eyebrow">{c.areas.eyebrow}</p>
      <h2>{c.areas.title}</h2>
      <span class="gold-rule gold-rule--center"></span>
    </header>
    <div class="cards">
      {c.areas.items.map((item, i) => (
        <article class="card reveal" style={`--d:${i * 90}ms`}>
          <div class="card__top">
            <img class="medal" src={`/icons/${item.icon}.jpg`} alt="" width="88" height="88" loading="lazy" />
            <span class="card__num">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
    <p class="note reveal">{c.areas.note}</p>
    <div class="areas-more reveal"><Button href={routes.solutions[lang]} variant="link" arrow>{c.areas.more}</Button></div>
  </div>
</section>

<!-- Visão de futuro: vídeo de fundo em loop (sem som) -->
<section class="vision" aria-label={c.vision.title}>
  <video class="vision__video" autoplay muted loop playsinline preload="metadata" poster="/video/ctb-robo-poster.jpg" aria-hidden="true">
    <source src="/video/ctb-robo.webm" type="video/webm" />
    <source src="/video/ctb-robo.mp4" type="video/mp4" />
  </video>
  <div class="vision__shade" aria-hidden="true"></div>
  <div class="container vision__inner reveal">
    <p class="eyebrow vision__eyebrow">{c.vision.eyebrow}</p>
    <h2>{c.vision.title}</h2>
    <span class="vision__rule" aria-hidden="true"></span>
    <p class="vision__text">{c.vision.text}</p>
    <Button href={routes.about[lang]} variant="secondary" arrow>{c.vision.button}</Button>
  </div>
</section>

<!-- 3 · Dubai (claro, editorial) -->
<section id="dubai" class="sec sec--light sec--champagne">
  <div class="container">
    <div class="reveal">
      <ImageSlot label={c.dubai.image} alt={c.dubai.image} ratio="21 / 9" class="dubai__pano"
        src="/brand/sec-dubai.jpg" srcSmall="/brand/sec-dubai-900.jpg" position="50% 55%" />
    </div>
    <div class="dubai__text">
      <div class="reveal">
        <p class="eyebrow">{c.dubai.eyebrow}</p>
        <h2>{c.dubai.title}</h2>
      </div>
      <div class="reveal" style="--d:120ms">
        <p class="lead">{c.dubai.lead}</p>
        <p>{c.dubai.body}</p>
      </div>
    </div>
  </div>
</section>

<!-- 4 · Filosofia (escuro) -->
<section id="filosofia" class="sec sec--dark sec--cafe sec--photo">
  <picture class="sec__photo" aria-hidden="true">
    <source media="(max-width: 900px)" srcset="/brand/sec-filosofia-900.jpg" />
    <img src="/brand/sec-filosofia.jpg" alt="" loading="lazy" decoding="async" />
  </picture>
  <div class="container">
    <header class="sec__head reveal">
      <p class="eyebrow">{c.philosophy.eyebrow}</p>
      <h2>{c.philosophy.title}</h2>
      <span class="gold-rule gold-rule--center"></span>
    </header>
    <ol class="values">
      {c.philosophy.items.map((item, i) => (
        <li class="reveal" style={`--d:${i * 90}ms`}>
          <div class="values__top">
            <img class="medal medal--sm" src={`/icons/${item.icon}.jpg`} alt="" width="72" height="72" loading="lazy" />
            <span class="values__num">{roman[i]}</span>
          </div>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- 5 · Chamada final (composição com imagem) -->
<section id="contato" class="contact">
  <picture class="contact__media" aria-hidden="true">
    <source media="(max-width: 800px)" srcset="/brand/cta-conversa-760.jpg" />
    <img src="/brand/cta-conversa.jpg" alt="" width="1042" height="724" loading="lazy" decoding="async" />
  </picture>
  <div class="contact__shade" aria-hidden="true"></div>
  <div class="contact__inner">
    <div class="contact__text reveal">
      <p class="eyebrow contact__eyebrow">{c.cta.eyebrow}</p>
      <h2>{c.cta.title}</h2>
      <span class="contact__rule" aria-hidden="true"></span>
      <p>{c.cta.text}</p>
      <Button href={c.cta.href} variant="primary" arrow blockMobile>{c.cta.button}</Button>
    </div>
  </div>
</section>


<style>
  .sec { padding-block: clamp(5rem, 11vw, 9rem); }
  .sec--light { background: var(--color-ivory); color: var(--color-espresso); }
  .sec--champagne { background: linear-gradient(180deg, var(--color-ivory) 0%, #efe3cf 100%); }
  .sec--dark { background: var(--color-espresso); color: var(--color-ivory); }
  .sec--cafe { background: linear-gradient(160deg, var(--color-cafe) 0%, var(--color-espresso) 70%); }
  /* Filosofia: foto de atendimento ao fundo, velada em espresso para manter a leitura */
  .sec--photo { position: relative; isolation: isolate; overflow: hidden; }
  .sec__photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 40%; z-index: -2; filter: var(--photo-tone); }
  .sec--photo::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(180deg, rgba(53, 36, 29, 0.92) 0%, rgba(53, 36, 29, 0.78) 45%, rgba(53, 36, 29, 0.94) 100%),
      linear-gradient(90deg, rgba(98, 72, 58, 0.25), rgba(53, 36, 29, 0.25));
  }

  h2 { font-size: clamp(2.2rem, 4.2vw, 3.6rem); font-weight: 400; margin: 0.9rem 0 0; line-height: 1.08; text-wrap: balance; }
  h3, .lead { text-wrap: balance; }
  .sec--light h2 { color: var(--color-espresso); }
  .sec--dark h2 { color: var(--color-champagne); }
  .sec--light .eyebrow { color: var(--color-cafe); }
  h3 { font-size: 1.6rem; font-weight: 500; margin: 0; }
  p { margin: 0 0 1.1rem; }
  .lead { font-family: var(--font-display); font-size: clamp(1.3rem, 1.9vw, 1.6rem); line-height: 1.45; }
  .sec--light p { color: var(--color-cafe); }
  .sec--light .lead { color: var(--color-espresso); }

  .gold-rule { display: block; width: 72px; height: 1px; background: var(--color-gold); margin: 1.8rem 0; }
  .gold-rule--center { margin-inline: auto; }
  .sec__head { text-align: center; max-width: 46rem; margin: 0 auto clamp(3rem, 6vw, 4.5rem); }

  /* 1 · Sobre */
  .about { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(3rem, 7vw, 7rem); align-items: center; }
  .about__text { max-width: 34rem; }
  .about__media { position: relative; }
  .about__frame { position: absolute; inset: 1.5rem -1.5rem -1.5rem 1.5rem; border: 1px solid var(--color-gold); opacity: 0.6; }

  /* 2 · Cartões */
  .areas-more { text-align: center; margin-top: 1rem; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); padding: 1px 0 0 1px; }
  .card { background: var(--color-espresso); border: 1px solid var(--color-line); margin: -1px 0 0 -1px; padding: clamp(2rem, 3vw, 2.75rem) clamp(1.5rem, 2.2vw, 2.25rem) 2.75rem; transition: background 0.4s ease; position: relative; }
  .card::before { content: ''; position: absolute; left: 0; top: 0; height: 1px; width: 0; background: var(--color-gold); transition: width 0.5s ease; }
  .card:hover { background: #3d2a22; }
  .card:hover::before { width: 100%; }
  .card__top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 2rem; }
  .card__num { font-family: var(--font-display); font-size: 1rem; color: var(--color-gold); letter-spacing: 0.2em; }
  /* Medalhas douradas: a imagem é quadrada, o recorte circular remove os cantos */
  .medal { width: 88px; height: 88px; border-radius: 50%; clip-path: circle(47% at 50% 50%); box-shadow: 0 10px 24px rgba(0, 0, 0, 0.25); transition: transform 0.5s cubic-bezier(.2,.7,.2,1); }
  .medal--sm { width: 72px; height: 72px; }
  .card:hover .medal, .values li:hover .medal { transform: translateY(-3px) scale(1.03); }
  .card h3 { color: var(--color-champagne); margin-bottom: 1rem; }
  .card p { color: var(--color-ivory); opacity: 0.78; font-size: 0.95rem; margin: 0; }
  .note { margin: 2.5rem auto 0; max-width: 44rem; text-align: center; font-size: 0.8rem; letter-spacing: 0.02em; color: var(--color-champagne); opacity: 0.65; }

  /* Visão de futuro (vídeo) */
  .vision { position: relative; isolation: isolate; overflow: hidden; min-height: clamp(520px, 72vh, 760px); display: flex; align-items: center; background: var(--color-espresso); color: var(--color-ivory); border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); }
  .vision__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 30% 35%; z-index: -2; }
  .vision__shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(270deg, rgba(53, 36, 29, 0.95) 0%, rgba(53, 36, 29, 0.85) 32%, rgba(53, 36, 29, 0.35) 52%, rgba(53, 36, 29, 0) 66%), linear-gradient(0deg, rgba(53, 36, 29, 0.6), rgba(53, 36, 29, 0) 30%); }
  .vision__inner { padding-block: clamp(4rem, 8vw, 6rem); }
  .vision__inner { display: flex; flex-direction: column; align-items: flex-start; padding-left: max(52%, 1rem); }
  .vision__inner > * { max-width: 32rem; }
  .vision__eyebrow { color: var(--color-gold) !important; }
  .vision h2 { color: var(--color-ivory); font-size: clamp(2.3rem, 4vw, 3.6rem); }
  .vision__rule { display: block; width: 72px; height: 1px; background: var(--color-gold); margin: 1.6rem 0; }
  .vision__text { color: var(--color-ivory); opacity: 0.9; margin-bottom: 2rem; }
  @media (prefers-reduced-motion: reduce) { .vision__video { display: none; } .vision { background: url('/video/ctb-robo-poster.jpg') center / cover; } }
  @media (max-width: 900px) { .vision__inner { padding-left: 1rem; } }
  @media (max-width: 700px) { .vision__shade { background: linear-gradient(0deg, rgba(53, 36, 29, 0.95) 0%, rgba(53, 36, 29, 0.6) 60%, rgba(53, 36, 29, 0.4) 100%); } .vision { align-items: flex-end; } }

  /* 3 · Dubai */
  .dubai__text { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2rem, 6vw, 6rem); margin-top: clamp(3rem, 6vw, 5rem); align-items: start; }

  /* 4 · Valores */
  .values { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1.5rem, 3vw, 3rem); }
  .values li { border-top: 1px solid var(--color-line); padding-top: 2rem; }
  .values__top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.4rem; }
  .values__num { font-family: var(--font-display); font-size: 1.6rem; color: var(--color-gold); line-height: 1; opacity: 0.85; }
  .values h3 { color: var(--color-champagne); margin-bottom: 0.8rem; }
  .values p { color: var(--color-ivory); opacity: 0.78; font-size: 0.95rem; margin: 0; }

  /* 5 · Contato — imagem à direita, degradê espresso à esquerda para o texto */
  .contact { position: relative; isolation: isolate; overflow: hidden; background: var(--color-espresso); color: var(--color-ivory); border-top: 1px solid var(--color-line); }
  .contact__media img { position: absolute; top: 0; right: 0; width: 62%; height: 100%; object-fit: cover; object-position: 60% 50%; z-index: -2; filter: var(--photo-tone); }
  .contact__shade { position: absolute; inset: 0; z-index: -1; background:
    linear-gradient(90deg, var(--color-espresso) 0%, var(--color-espresso) 38%, rgba(53, 36, 29, 0.85) 46%, rgba(53, 36, 29, 0.35) 60%, rgba(53, 36, 29, 0) 75%),
    linear-gradient(0deg, rgba(53, 36, 29, 0.55) 0%, rgba(53, 36, 29, 0) 25%); }
  /* curva metálica sutil, ecoando as curvas do hero */
  .contact::after { content: ''; position: absolute; left: -10%; right: 30%; bottom: -60px; height: 120px; border-top: 1px solid rgba(232, 214, 183, 0.25); border-radius: 50%; z-index: -1; pointer-events: none; }
  .contact__inner { min-height: clamp(420px, 34vw, 520px); display: flex; align-items: center; padding: clamp(3.5rem, 6vw, 5rem) clamp(1.25rem, 6vw, 6rem); }
  .contact__text { max-width: 30rem; }
  .contact__eyebrow { color: var(--color-gold); margin: 0; display: flex; align-items: center; gap: 1rem; }
  .contact__eyebrow::after { content: ''; width: 4.5rem; height: 1px; background: var(--color-gold); opacity: 0.6; }
  .contact h2 { color: var(--color-ivory); font-size: clamp(2.2rem, 3.4vw, 3.2rem); margin-top: 1rem; }
  .contact__rule { display: block; width: 72px; height: 1px; background: var(--color-gold); margin: 1.5rem 0; }
  .contact p { color: var(--color-ivory); opacity: 0.85; margin-bottom: 2rem; }

  @media (max-width: 800px) {
    .contact__media img { position: relative; width: 100%; height: auto; aspect-ratio: 1042 / 724; }
    .contact__shade { background: linear-gradient(180deg, rgba(53, 36, 29, 0) 0%, rgba(53, 36, 29, 0) 25%, rgba(53, 36, 29, 0.9) 40%, var(--color-espresso) 46%); }
    .contact__inner { min-height: 0; margin-top: -1.5rem; padding-top: 0; }
    .contact::after { display: none; }
  }

  /* Animação de entrada */
  .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.9s ease, transform 0.9s ease; transition-delay: var(--d, 0ms); }
  .reveal.is-visible { opacity: 1; transform: none; }

  @media (max-width: 1000px) {
    .about, .dubai__text { grid-template-columns: 1fr; }
    .about__media { max-width: 30rem; }
    .cards { grid-template-columns: 1fr; }
    .values { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .cards, .values { grid-template-columns: 1fr; }
    .about__frame { inset: 1rem -0.5rem -1rem 1rem; }
  }
</style>
