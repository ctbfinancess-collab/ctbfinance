---
/** Banner das páginas internas: imagem de fundo + véu espresso + título. */
interface Props {
  image?: string;      // /brand/x.jpg (versão grande) — sem imagem, usa fundo espresso provisório
  imageSmall?: string; // versão para celular
  position?: string;   // enquadramento da imagem
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: { label: string; href?: string }[];
  /** Altura acompanha a proporção da imagem (mostra a imagem inteira) e título mais compacto */
  fit?: string; // ex.: '2172 / 724'
  /** Imagem inteira no topo, sem véu, e o título numa faixa abaixo (para imagens com o emblema à esquerda) */
  stacked?: boolean;
  /** Imagem ocupa só o lado direito (ex.: '62%'), fundindo-se ao espresso à esquerda */
  side?: string;
  /** Frase exibida sobre o vídeo (texto do site, não altera o vídeo) — modo stacked */
  caption?: string;
  /** Vídeo sem o filtro de tom (cores originais) */
  natural?: boolean;
  /** Vídeo de fundo em loop, sem som (ex.: '/video/x' → x.webm + x.mp4 + x-poster.jpg) */
  video?: string;
}
const { image, imageSmall, position = '70% 50%', eyebrow, title, lead, crumbs = [], fit, stacked = false, side, video, caption, natural = false } = Astro.props;
---
<section class:list={['pb', { 'pb--fit': fit, 'pb--stacked': stacked, 'pb--side': side, 'pb--natural': natural }]} style={[fit && `--pb-ratio: ${fit}`, side && `--pb-side: ${side}`].filter(Boolean).join(';') || undefined}>
  {video ? (
    <div class="pb__media">
      <video class="pb__video" autoplay muted loop playsinline preload="metadata" poster={`${video}-poster.jpg`} aria-hidden="true">
        {!stacked && <source src={`${video}.webm`} type="video/webm" />}
        <source src={`${video}.mp4`} type="video/mp4" />
      </video>
      {caption && <p class="pb__caption"><span aria-hidden="true"></span>{caption}<span aria-hidden="true"></span></p>}
    </div>
  ) : image ? (
    <picture class="pb__bg" aria-hidden="true">
      {imageSmall && <source media="(max-width: 900px)" srcset={imageSmall} />}
      <img src={image} alt="" fetchpriority="high" style={`object-position: ${position}`} />
    </picture>
  ) : (
    <div class="pb__placeholder" aria-hidden="true"></div>
  )}
  <div class="pb__shade" aria-hidden="true"></div>
  <div class="pb__content">
    {crumbs.length > 0 && (
      <nav class="pb__crumbs" aria-label="Breadcrumb">
        {crumbs.map((c, i) => (
          <>
            {i > 0 && <span aria-hidden="true">/</span>}
            {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
          </>
        ))}
      </nav>
    )}
    {eyebrow && <p class="eyebrow pb__eyebrow">{eyebrow}</p>}
    <span class="pb__rule" aria-hidden="true"></span>
    <h1>{title}</h1>
    {lead && <p class="pb__lead">{lead}</p>}
  </div>
</section>

<style>
  .pb { position: relative; isolation: isolate; overflow: hidden; min-height: clamp(460px, 68vh, 680px); display: flex; align-items: flex-end; background: var(--color-espresso); color: var(--color-ivory); }
  .pb__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 70% 40%; z-index: -2; }
  @media (prefers-reduced-motion: reduce) { .pb__video { display: none; } }
  .pb__placeholder { position: absolute; inset: 0; z-index: -2; background: radial-gradient(ellipse 60% 80% at 78% 40%, rgba(181, 139, 77, 0.35), transparent 70%), linear-gradient(135deg, var(--color-cafe) 0%, var(--color-espresso) 60%); }
  .pb__bg img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; filter: var(--photo-tone); }
  /* Espresso #35241D: esquerda escura para o texto, direita preservando a arquitetura */
  .pb__shade { position: absolute; inset: 0; z-index: -1; background:
    linear-gradient(90deg, rgba(53, 36, 29, 0.88) 0%, rgba(53, 36, 29, 0.66) 32%, rgba(53, 36, 29, 0.2) 55%, rgba(53, 36, 29, 0) 70%),
    linear-gradient(0deg, rgba(53, 36, 29, 0.6) 0%, rgba(53, 36, 29, 0) 30%),
    linear-gradient(180deg, rgba(53, 36, 29, 0.45) 0%, rgba(53, 36, 29, 0) 22%); }
  .pb__content { width: 100%; max-width: 62rem; padding: calc(96px + 3rem) clamp(1.25rem, 6vw, 6rem) clamp(3rem, 7vw, 5.5rem); }
  .pb__crumbs { display: flex; gap: 0.6rem; font-size: 0.78rem; letter-spacing: 0.08em; margin-bottom: 2rem; color: var(--color-champagne); }
  .pb__crumbs a { color: var(--color-champagne); opacity: 0.7; }
  .pb__crumbs a:hover { color: var(--color-gold); opacity: 1; }
  .pb__crumbs span[aria-hidden] { opacity: 0.4; }
  .pb__eyebrow { margin: 0; color: var(--color-champagne); font-weight: 500; letter-spacing: 0.34em; }
  .pb__rule { display: block; width: 7rem; height: 1px; background: var(--color-gold); margin: 1.4rem 0 1.6rem; }
  h1 { margin: 0; font-size: clamp(2.6rem, 5vw, 4.6rem); font-weight: 400; line-height: 1.05; text-wrap: balance; color: var(--color-ivory); }
  .pb__lead { margin: 1.5rem 0 0; max-width: 36rem; font-size: clamp(1rem, 1.3vw, 1.2rem); font-weight: 300; opacity: 0.9; text-wrap: balance; }
  /* Modo "side": imagem só à direita, com a borda esquerda dissolvida no espresso */
  .pb--side .pb__bg img { left: auto; right: 0; width: var(--pb-side); -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 30%); mask-image: linear-gradient(to right, transparent 0%, #000 30%); }
  .pb--side .pb__video { left: auto; right: 0; width: var(--pb-side); object-position: 50% 40%; -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 30%); mask-image: linear-gradient(to right, transparent 0%, #000 30%); }
  @media (max-width: 700px) { .pb--side .pb__bg img, .pb--side .pb__video { width: 100%; -webkit-mask-image: none; mask-image: none; } }
  /* Modo "fit": a seção tem a mesma proporção da imagem, então ela aparece inteira */
  .pb--fit { min-height: 0; aspect-ratio: var(--pb-ratio); align-items: center; }
  .pb--fit .pb__content { padding-top: calc(80px + 1.5rem); padding-bottom: clamp(1.5rem, 3vw, 2.5rem); max-width: 44rem; }
  .pb--fit .pb__crumbs { margin-bottom: 1.2rem; }
  .pb--fit .pb__rule { margin: 1rem 0 1.1rem; width: 5rem; }
  .pb--fit h1 { font-size: clamp(2rem, 3.3vw, 3.3rem); }
  .pb--fit .pb__lead { margin-top: 1rem; }
  /* Modo "stacked": imagem inteira, sem filtro nem véu lateral; texto numa faixa espresso abaixo */
  /* imagem começa abaixo do cabeçalho, para o emblema não ficar escondido */
  .pb.pb--stacked { display: block; min-height: 0; aspect-ratio: auto; padding-top: 84px; }
  .pb--stacked .pb__bg img { position: static; display: block; width: 100%; height: auto; aspect-ratio: var(--pb-ratio, 3 / 1); filter: var(--photo-tone); }
  .pb--stacked .pb__shade { display: none; }
  .pb__media { display: contents; }
  .pb--stacked .pb__media { display: block; position: relative; }
  .pb.pb--natural .pb__video { filter: none; object-position: 50% 45%; top: 84px; height: calc(100% - 84px); }
  @media (max-width: 700px) { .pb.pb--natural .pb__video { top: 0; height: 100%; } }
  .pb__caption { position: absolute; left: clamp(1.25rem, 4vw, 4rem); top: 50%; transform: translateY(-50%); max-width: min(30rem, 38%); margin: 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(1.5rem, 3.6vw, 3.4rem); line-height: 1.1; color: var(--color-ivory); text-shadow: 0 2px 18px rgba(53, 36, 29, 0.75); text-wrap: balance; }
  .pb__caption span { display: block; width: 3rem; height: 1px; background: var(--color-gold); margin: 1.1rem 0; }
  @media (max-width: 600px) { .pb__caption { font-size: 1.25rem; max-width: 55%; } .pb__caption span { margin: 0.6rem 0; width: 2rem; } }
  /* vídeo no modo stacked: original exato, inteiro, sem filtro, recorte ou véu */
  .pb--stacked .pb__video { position: static; display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: contain; filter: none; -webkit-mask-image: none; mask-image: none; }
  .pb--stacked .pb__content { max-width: none; padding-top: clamp(2rem, 4vw, 3rem); padding-bottom: clamp(2.5rem, 5vw, 3.5rem); background: var(--color-espresso); border-top: 1px solid var(--color-line); display: grid; grid-template-columns: auto 1fr; column-gap: clamp(2rem, 6vw, 6rem); align-items: end; }
  .pb--stacked .pb__crumbs, .pb--stacked .pb__eyebrow, .pb--stacked .pb__rule { grid-column: 1 / -1; }
  .pb--stacked h1 { font-size: clamp(2.2rem, 3.6vw, 3.4rem); max-width: 40rem; }
  .pb--stacked .pb__lead { margin: 0 0 0.4rem; max-width: 30rem; }
  @media (max-width: 800px) {
    .pb.pb--stacked { padding-top: 72px; }
    .pb--stacked .pb__bg img { aspect-ratio: 16 / 9; object-fit: cover; object-position: 18% 50%; }
    .pb--stacked .pb__content { grid-template-columns: 1fr; }
    .pb--stacked .pb__lead { margin-top: 1rem; }
  }
  @media (max-width: 1000px) {
    /* telas estreitas: a proporção 3:1 ficaria baixa demais para o texto */
    .pb--fit:not(.pb--stacked) { aspect-ratio: auto; min-height: 460px; align-items: flex-end; }
  }
  @media (max-width: 700px) {
    .pb__shade { background: linear-gradient(0deg, rgba(53, 36, 29, 0.95) 0%, rgba(53, 36, 29, 0.7) 55%, rgba(53, 36, 29, 0.5) 100%); }
  }
</style>
