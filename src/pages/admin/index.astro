---
/**
 * Admin da CTB Finances (/admin/; somente contas com papel de equipe). Fora dos buscadores e do sitemap.
 * Tudo vem da API /api/cliente/equipe/* (sessão HttpOnly; conta sem papel de equipe recebe 404).
 * Dados de clientes são inseridos na página sempre como TEXTO (nunca como HTML).
 */
import '../../styles/global.css';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>Admin · CTB Finances</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!-- Entrar -->
    <section class="tela-entrar" data-vista="entrar" hidden>
      <div class="cartao-entrar">
        <img src="/brand/ctb-eagle.png" alt="" width="120" height="56" class="aguia" />
        <img src="/brand/ctb-wordmark-ouro.png" alt="CTB Finances" class="palavra-grande" />
        <h1>Admin</h1>
        <p class="nota">Acesso restrito à equipe da CTB Finances.</p>
        <form data-form-entrar novalidate>
          <label><span>E-mail</span><input type="email" name="email" autocomplete="username" required /></label>
          <label><span>Senha</span><input type="password" name="senha" autocomplete="current-password" required /></label>
          <button type="submit" class="botao">Entrar</button>
        </form>
        <p class="msg" data-msg-entrar hidden></p>
      </div>
    </section>

    <p class="carregando" data-vista="carregando">Carregando…</p>

    <!-- Admin -->
    <div class="app" data-vista="painel" hidden>
      <aside class="lateral">
        <a href="/" class="marca"><img src="/brand/ctb-eagle.png" alt="" width="64" height="30" /><img src="/brand/ctb-wordmark-ouro.png" alt="CTB Finances" class="palavra" /></a>
        <nav class="menu" role="tablist" aria-label="Admin">
          <button role="tab" data-aba="geral" aria-selected="true"><svg viewBox="0 0 24 24"><path d="M3 11.5 12 4l9 7.5"/><path d="M5 10v10h5v-6h4v6h5V10"/></svg><span>Dashboard</span></button>
          <button role="tab" data-aba="interessados"><svg viewBox="0 0 24 24"><path d="M4 5h16v11H8l-4 4z"/><path d="M8 9h8M8 12h5"/></svg><span>Interessados</span><b data-cont="interessados_novos"></b></button>
          <button role="tab" data-aba="clientes"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.5"/><path d="M15.5 14.2c2.9.3 5.5 2.6 5.5 5.8"/></svg><span>Clientes</span></button>
          <button role="tab" data-aba="agendamentos"><svg viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/><path d="m9 15 2 2 4-4"/></svg><span>Agendamentos</span><b data-cont="agendamentos_pendentes"></b></button>
          <button role="tab" data-aba="documentos"><svg viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M9 12h6M9 16h6"/></svg><span>Documentos</span><b data-cont="documentos_em_analise"></b></button>
          <button role="tab" data-aba="registro"><svg viewBox="0 0 24 24"><path d="M4 5h16M4 10h16M4 15h10M4 20h7"/><circle cx="18" cy="18" r="3"/></svg><span>Registro</span></button>
        </nav>
        <p class="menu-titulo">Em breve</p>
        <ul class="menu breve" aria-label="Módulos em preparação">
          <li><svg viewBox="0 0 24 24"><path d="M4 8h14l-3-3M20 16H6l3 3"/></svg><span>Operações</span></li>
          <li><svg viewBox="0 0 24 24"><ellipse cx="12" cy="6" rx="7" ry="2.5"/><path d="M5 6v4c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5V6M5 10v4c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-4M5 14v4c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-4"/></svg><span>Crédito e Financiamento</span></li>
          <li><svg viewBox="0 0 24 24"><path d="M12 3 5 6v6c0 4.2 3 7.6 7 9 4-1.4 7-4.8 7-9V6z"/><path d="m9 12 2 2 4-4"/></svg><span>Compliance (KYC/AML)</span></li>
        </ul>
        <div class="quem" data-quem hidden><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.9 3.1-7 7-7s7 3.1 7 7"/></svg><span data-email></span><button type="button" class="sair" data-sair title="Sair"><svg viewBox="0 0 24 24"><path d="M15 4h4v16h-4M10 8l-4 4 4 4M6 12h10"/></svg><span>Sair</span></button></div>
        <div class="onda" aria-hidden="true"></div>
      </aside>

      <div class="principal">
        <header class="faixa">
          <button type="button" class="voltar" data-voltar hidden title="Voltar para a tela anterior"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></svg>Voltar</button>
          <div class="faixa__txt">
            <h1>Painel da Equipe – <em>Administração</em></h1>
            <p data-subtitulo>Gestão de clientes, agendamentos e documentos</p>
          </div>
        </header>

        <main class="conteudo">
          <p class="msg" data-msg hidden></p>

          <div data-painel="geral">
            <div class="kpis" data-numeros>
              <button type="button" class="kpi" data-ir="clientes"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.5"/><path d="M15.5 14.2c2.9.3 5.5 2.6 5.5 5.8"/></svg><div><span class="kpi__n" data-k="clientes">–</span><span class="kpi__t">Clientes</span><small data-k-sub="clientes_ativos"></small></div></button>
              <button type="button" class="kpi" data-ir="clientes"><svg viewBox="0 0 24 24"><circle cx="10" cy="8" r="3.2"/><path d="M4 20c0-3.3 2.7-6 6-6 1.2 0 2.3.3 3.2.9M18 14v6M15 17h6"/></svg><div><span class="kpi__n" data-k="convites_pendentes">–</span><span class="kpi__t">Convites sem senha criada</span></div></button>
              <button type="button" class="kpi" data-ir="agendamentos"><svg viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/><path d="m9 15 2 2 4-4"/></svg><div><span class="kpi__n" data-k="agendamentos_pendentes">–</span><span class="kpi__t">Agendamentos a confirmar</span></div></button>
              <button type="button" class="kpi" data-ir="documentos"><svg viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M9 12h6M9 16h6"/></svg><div><span class="kpi__n" data-k="documentos_em_analise">–</span><span class="kpi__t">Documentos em análise</span></div></button>
              <button type="button" class="kpi" data-ir="clientes"><svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2"/><circle cx="12" cy="10" r="3"/><path d="M9 17h6"/></svg><div><span class="kpi__n" data-k="passaportes_a_conferir">–</span><span class="kpi__t">Passaportes a conferir</span></div></button>
            </div>

            <div class="grade">
              <section class="quadro grafico">
                <h2>Novos clientes <small>últimos 12 meses</small></h2>
                <div data-grafico></div>
              </section>
              <section class="quadro">
                <h2>Demandas da equipe</h2>
                <div class="demandas" data-demandas></div>
              </section>
              <section class="quadro">
                <h2>Ações rápidas</h2>
                <div class="rapidas">
                  <button type="button" data-ir="interessados"><svg viewBox="0 0 24 24"><path d="M4 5h16v11H8l-4 4z"/><path d="M8 9h8M8 12h5"/></svg><span>Ver interessados</span></button>
                  <button type="button" data-rapida="convidar"><svg viewBox="0 0 24 24"><circle cx="10" cy="8" r="3.2"/><path d="M4 20c0-3.3 2.7-6 6-6 1.2 0 2.3.3 3.2.9M18 14v6M15 17h6"/></svg><span>Cadastrar cliente</span></button>
                  <button type="button" data-ir="agendamentos"><svg viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/><path d="m9 15 2 2 4-4"/></svg><span>Confirmar agendamentos</span></button>
                  <button type="button" data-ir="documentos"><svg viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M9 12h6M9 16h6"/></svg><span>Analisar documentos</span></button>
                  <button type="button" data-ir="clientes"><svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2"/><circle cx="12" cy="10" r="3"/><path d="M9 17h6"/></svg><span>Conferir passaportes</span></button>
                  <button type="button" data-ir="registro"><svg viewBox="0 0 24 24"><path d="M4 5h16M4 10h16M4 15h10M4 20h7"/><circle cx="18" cy="18" r="3"/></svg><span>Ver registro</span></button>
                </div>
              </section>
            </div>

            <div class="grade dupla">
              <section class="quadro">
                <h2>Atividade recente <button type="button" class="ver" data-ir="registro">Ver tudo →</button></h2>
                <div data-atividade></div>
              </section>
              <section class="quadro">
                <h2>Próximos agendamentos <button type="button" class="ver" data-ir="agendamentos">Ver todos →</button></h2>
                <div data-proximos></div>
              </section>
            </div>
            <p class="nota rodape">Somente dados reais do sistema. A sessão do Admin encerra após 30 minutos sem uso.</p>
          </div>

          <div data-painel="interessados" hidden>
            <div class="filtro">
              <select data-int-status>
                <option value="novo">Novos</option>
                <option value="respondido">Respondidos</option>
                <option value="convidado">Convidados</option>
                <option value="arquivado">Arquivados</option>
                <option value="">Todos</option>
              </select>
              <span class="nota">Pedidos recebidos pelos formulários "Seja nosso cliente" e "Contato" do site.</span>
            </div>
            <div data-interessados></div>
          </div>

          <div data-painel="clientes" hidden>
          <form class="quadro convite" data-form-convite novalidate>
            <h2>Convidar cliente</h2>
            <div class="linha">
              <label><span>Nome</span><input name="nome" maxlength="120" /></label>
              <label><span>E-mail</span><input name="email" type="email" required maxlength="160" /></label>
              <label><span>Idioma do convite</span><select name="idioma"><option value="pt">Português</option><option value="en">Inglês</option></select></label>
              <button type="submit" class="botao">Enviar convite</button>
            </div>
          </form>
          <div class="busca"><input type="search" placeholder="Buscar por nome ou e-mail" data-busca /></div>
          <div class="tabela" data-clientes></div>
        </div>

        <div data-painel="agendamentos" hidden>
          <div class="filtro"><label><input type="checkbox" data-agenda-todos /> Mostrar também os já confirmados</label></div>
          <div data-agendamentos></div>
        </div>

        <div data-painel="documentos" hidden>
          <div class="filtro">
            <select data-doc-status>
              <option value="disponivel_analise">Em análise</option>
              <option value="aprovado">Aprovados</option>
              <option value="rejeitado">Rejeitados</option>
              <option value="">Todos</option>
            </select>
          </div>
          <div data-documentos></div>
        </div>

        <div data-painel="registro" hidden>
          <div class="tabela" data-registro></div>
        </div>
        </main>
      </div>
    </div>

    <!-- Ficha do cliente -->
    <dialog class="ficha" data-ficha>
      <div class="ficha__topo"><h2 data-ficha-titulo></h2><button type="button" class="fechar" data-fechar aria-label="Fechar">×</button></div>
      <div data-ficha-corpo></div>
      <p class="msg msg-janela" data-msg-ficha hidden role="status" aria-live="polite"></p>
    </dialog>

    <!-- Rejeitar documento -->
    <dialog class="ficha pequena" data-rejeitar>
      <form method="dialog" data-form-rejeitar>
        <div class="ficha__topo"><h2>Rejeitar documento</h2><button type="button" class="fechar" data-fechar aria-label="Fechar">×</button></div>
        <p class="nota" data-rejeitar-qual></p>
        <label><span>Orientação ao cliente (português) *</span><textarea name="pt" rows="3" maxlength="1000" required placeholder="Ex.: A imagem está ilegível. Envie uma nova foto do passaporte, com boa iluminação."></textarea></label>
        <label><span>Orientação em inglês (opcional)</span><textarea name="en" rows="2" maxlength="1000"></textarea></label>
        <div class="acoes"><button type="submit" class="botao perigo" value="ok">Rejeitar</button><button type="button" class="link" data-fechar>Cancelar</button></div>
      </form>
    </dialog>

    <script>
      const API = '/api/cliente';
      const $ = <T extends HTMLElement = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector<T>(s)!;
      const $$ = <T extends HTMLElement = HTMLElement>(s: string, r: ParentNode = document) => [...r.querySelectorAll<T>(s)];
      // cria elementos com TEXTO (dados de clientes nunca viram HTML)
      function el(tag: string, props: Record<string, any> = {}, ...filhos: (Node | string | null | false | undefined)[]) {
        const e = document.createElement(tag);
        for (const [k, v] of Object.entries(props)) {
          if (v === undefined || v === null || v === false) continue;
          if (k === 'class') e.className = v; else if (k.startsWith('on')) e.addEventListener(k.slice(2), v); else if (k === 'dataset') Object.assign(e.dataset, v); else e.setAttribute(k, v === true ? '' : String(v));
        }
        for (const f of filhos) if (f !== null && f !== undefined && f !== false) e.append(typeof f === 'string' ? document.createTextNode(f) : f);
        return e;
      }
      const ASSUNTOS: Record<string, string> = { abertura_conta: 'Abertura de conta', investimentos: 'Investimentos', documentos: 'Documentos', outro: 'Outro assunto' };
      const FORMATOS: Record<string, string> = { video: 'Vídeo', telefone: 'Telefone', presencial: 'Presencial' };
      const PERIODOS: Record<string, string> = { manha: 'Manhã (9h–12h)', tarde: 'Tarde (13h–18h)', qualquer: 'Qualquer horário' };
      const ST_DOC: Record<string, string> = { disponivel_analise: 'Em análise', aprovado: 'Aprovado', rejeitado: 'Rejeitado' };
      const ACOES: Record<string, string> = { convidar: 'Convidou', reenviar_acesso: 'Reenviou acesso', reenviar: 'Reenviou acesso', bloquear: 'Bloqueou', desbloquear: 'Desbloqueou', passaporte_conferir: 'Conferiu passaporte', passaporte_liberar: 'Destravou passaporte', confirmar_agendamento: 'Confirmou agendamento', aprovar_documento: 'Aprovou documento', rejeitar_documento: 'Rejeitou documento', ver_ficha: 'Abriu a ficha', baixar_documento: 'Baixou documento', editar_dados: 'Editou dados', financeiro_conta: 'Lançou saldo', financeiro_conta_excluida: 'Excluiu conta', financeiro_movimento: 'Lançou movimentação', financeiro_movimento_excluido: 'Excluiu movimentação', financeiro_posicao: 'Lançou investimento', financeiro_posicao_excluida: 'Excluiu investimento', financeiro_cartao: 'Atualizou cartão', financeiro_cartao_removido: 'Removeu cartão', interessado_respondido: 'Marcou interessado como respondido', interessado_arquivado: 'Arquivou interessado', interessado_novo: 'Reabriu interessado' };
      const dataHora = (s: string) => new Date(s).toLocaleString('pt-BR', { timeZone: 'Asia/Dubai', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
      const dataCivil = (s: string) => { const [a, m, d] = s.split('-'); return `${d}/${m}/${a}`; };
      const tamanho = (n: number) => (n > 1048576 ? (n / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(n / 1024)) + ' KB');

      let eu: { email: string } | null = null;
      const vista = (v: string) => $$('[data-vista]').forEach((x) => (x.hidden = x.dataset.vista !== v));
      const aviso = (t: string, tipo: 'ok' | 'erro' = 'ok') => {
        // com a ficha aberta, a mensagem aparece DENTRO dela (fixa embaixo); senão, no topo da página
        const fichaAberta = (document.querySelector('[data-ficha]') as HTMLDialogElement | null)?.open;
        const m = fichaAberta ? $('[data-msg-ficha]') : $('[data-msg]');
        m.hidden = false; m.textContent = (tipo === 'ok' ? '✓ ' : '⚠ ') + t; m.dataset.tipo = tipo;
        clearTimeout((m as any).t); (m as any).t = setTimeout(() => (m.hidden = true), tipo === 'ok' ? 4000 : 9000);
      };

      async function chamar(rota: string, opts: { metodo?: string; corpo?: unknown } = {}) {
        const r = await fetch(API + rota, { method: opts.metodo || 'GET', credentials: 'same-origin', headers: opts.corpo !== undefined ? { 'Content-Type': 'application/json' } : {}, body: opts.corpo !== undefined ? JSON.stringify(opts.corpo) : undefined });
        if (r.status === 401) { sessaoCaiu(); throw Object.assign(new Error('sessao'), { silencioso: true }); }
        const d = await r.json().catch(() => ({}));
        if (!r.ok) throw Object.assign(new Error(d.mensagem || 'Não foi possível concluir. Tente novamente.'), { status: r.status, d });
        return d;
      }
      const falhou = (e: any) => { if (!e.silencioso) aviso(e.message, 'erro'); };
      function sessaoCaiu() { eu = null; $('[data-quem]').hidden = true; vista('entrar'); const m = $('[data-msg-entrar]'); m.hidden = false; m.textContent = 'Sua sessão terminou. Entre novamente.'; }

      // ---- entrar / sair
      $('[data-form-entrar]').addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = new FormData(e.target as HTMLFormElement); const m = $('[data-msg-entrar]'); m.hidden = true;
        const r = await fetch(API + '/entrar', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: String(f.get('email')).trim(), senha: String(f.get('senha')) }) }).catch(() => null);
        if (!r || !r.ok) { m.hidden = false; m.textContent = r && r.status === 429 ? 'Muitas tentativas. Aguarde alguns minutos.' : 'E-mail ou senha incorretos.'; return; }
        (e.target as HTMLFormElement).reset(); iniciar();
      });
      $('[data-sair]').addEventListener('click', async () => { await fetch(API + '/sair', { method: 'POST', credentials: 'same-origin' }).catch(() => {}); eu = null; $('[data-quem]').hidden = true; vista('entrar'); });

      // ---- abas
      let abaAtual = '';
      const carregar: Record<string, () => Promise<void>> = {};
      // cada lista só é desenhada pela resposta MAIS RECENTE (respostas atrasadas são descartadas)
      const versao: Record<string, number> = {};
      const nova = (k: string) => (versao[k] = (versao[k] || 0) + 1);
      const vigente = (k: string, v: number) => versao[k] === v;
      const SUB: Record<string, string> = { geral: 'Gestão de clientes, agendamentos e documentos', interessados: 'Interessados — pedidos recebidos pelos formulários do site', clientes: 'Clientes — convites, fichas, passaportes e acessos', agendamentos: 'Agendamentos — pedidos e confirmações (horário de Dubai)', documentos: 'Documentos — análise e decisão', registro: 'Registro — todas as ações da equipe' };
      // histórico: cada aba e cada ficha viram um passo; "Voltar" (e o botão do navegador) retornam ao anterior
      const ABAS = ['geral', 'interessados', 'clientes', 'agendamentos', 'documentos', 'registro'];
      let passos = 0;
      const btnVoltar = $('[data-voltar]');
      const marcarVoltar = () => (btnVoltar.hidden = passos <= 0 && abaAtual === 'geral' && !ficha.open);
      // com histórico: volta um passo; sem histórico (ex.: página recarregada): vai ao Dashboard
      btnVoltar.addEventListener('click', () => { if (passos > 0) history.back(); else abrirAba('geral'); });
      function abrirAba(a: string, registrar = true) {
        if (!ABAS.includes(a)) a = 'geral';
        if (registrar && a !== abaAtual) { history.pushState({ aba: a }, '', '#' + a); passos++; marcarVoltar(); }
        abaAtual = a; marcarVoltar();
        $('[data-subtitulo]').textContent = SUB[a] || '';
        $$('[data-aba]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.aba === a)));
        $$('[data-painel]').forEach((p) => (p.hidden = p.dataset.painel !== a));
        carregar[a]?.().catch(falhou);
      }
      $$('[data-aba]').forEach((b) => b.addEventListener('click', () => abrirAba(b.dataset.aba!)));
      let fechandoPeloHistorico = false;
      window.addEventListener('popstate', (e) => {
        if (!eu) return;
        passos = Math.max(0, passos - 1); marcarVoltar();
        const st = (e.state || {}) as { aba?: string; ficha?: string };
        if (ficha.open && !st.ficha) { fechandoPeloHistorico = true; ficha.close(); fechandoPeloHistorico = false; }
        abrirAba(st.aba || location.hash.slice(1).split('/')[0] || 'geral', false);
        if (st.ficha && !ficha.open) abrirFicha(st.ficha, true, false);
      });
      const atualizar = async () => { await atualizarResumo().catch(falhou); await carregar[abaAtual]?.().catch(falhou); };

      // ---- visão geral
      const MESES = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
      const NS = 'http://www.w3.org/2000/svg';
      const svg = (tag: string, at: Record<string, string | number>) => { const e = document.createElementNS(NS, tag); for (const [k, v] of Object.entries(at)) e.setAttribute(k, String(v)); return e; };
      function grafico(dados: { mes: string; n: number }[]) {
        const W = 560, H = 190, L = 34, B = 26, T = 12, R = 10;
        const max = Math.max(4, ...dados.map((d) => d.n)); const passo = Math.ceil(max / 4);
        const topo = passo * 4;
