---
/**
 * Portal autenticado da Área do Cliente.
 * Conversa com a API do próprio site no Railway (/api/cliente/*): sessão em cookie HttpOnly, banco Postgres
 * e arquivos no volume do Railway. A área só fica ativa quando o servidor responde { ativo: true } em
 * /api/cliente/status (banco e volume configurados); senão mostra "acesso em preparação".
 */
import { portal } from '../i18n/portal';
import { routes } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = portal[lang];

const profileFields = ['display_name', 'phone_number', 'nationality', 'dateofbirth', 'address', 'residencenumber', 'city', 'country', 'zipcode'] as const;
const companyFields = ['CompanyName', 'Companyregistrationnumber', 'companysadress', 'companyaddressnumber', 'companycity', 'companycountry', 'companyzipcode'] as const;
---
<div class="portal" data-portal data-lang={lang}
  data-msg={JSON.stringify({ loginError: p.loginError, tooMany: p.tooMany, genericError: p.genericError, resetSent: p.resetSent, signingIn: p.signingIn, submit: p.submit, saved: p.saved, saving: p.saving, save: p.save, nothingChanged: p.nothingChanged, verifySent: p.verifySent, uploaded: p.uploaded, uploading: p.uploading, upload: p.upload, badType: p.badType, tooBig: p.tooBig, docsEmpty: p.docsEmpty, apptEmpty: p.apptEmpty, download: p.download, tz: p.tz, st: p.docStatus, resendHint: p.resendHint, pendingHint: p.pendingHint, apptRequested: p.apptRequested, apptConfirmed: p.apptConfirmed, apptToConfirm: p.apptToConfirm, apptLegacy: p.apptLegacy, apptPending: p.apptPending, sessionEnded: p.sessionEnded, unavailable: p.unavailable, pwErr: p.pwErr, linkInvalid: p.linkInvalid, pwMismatch: p.pwMismatch, setPwInvite: p.setPwInvite, setPwReset: p.setPwReset, quota: p.quota, passportKeep: p.passportKeep, passportLocked: p.passportLocked, passportBad: p.passportBad, passportBadDate: p.passportBadDate, passportLockedErr: p.passportLockedErr, apptSend: p.apptSend, apptSending: p.apptSending, apptSent: p.apptSent, apptBadDate: p.apptBadDate, apptLimit: p.apptLimit, assuntos: p.assuntos, formatos: p.formatos, periodos: p.periodos, apptChoose: p.apptChoose })}>

  <!-- Login -->
  <div class="access-card" data-view="login">
    <p class="eyebrow eyebrow--gold">{lang === 'pt' ? 'Acesso' : 'Access'}</p>
    <h2>{p.loginTitle}</h2>
    <span class="gold-rule"></span>
    <form class="access-form" data-login novalidate>
      <fieldset disabled data-login-fs>
        <label><span>{p.email}</span><input type="email" name="email" autocomplete="username" required /></label>
        <label><span>{p.password}</span><input type="password" name="password" autocomplete="current-password" required minlength="6" /></label>
        <button type="submit" class="btn btn--primary" data-login-btn>{p.submit}</button>
        <button type="button" class="forgot" data-go="reset">{p.forgot}</button>
      </fieldset>
      <p class="msg" role="status" aria-live="polite" hidden data-login-msg></p>
    </form>
    <p class="access-status" role="status" data-indisponivel>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
      {p.unavailable}
    </p>
    <p class="access-client">{lang === 'pt' ? 'Ainda não é cliente?' : 'Not a client yet?'} <a href={routes.client[lang]}>{lang === 'pt' ? 'Seja nosso cliente' : 'Become a client'}</a></p>
  </div>

  <!-- Recuperar senha -->
  <div class="access-card" data-view="reset" hidden>
    <p class="eyebrow eyebrow--gold">{lang === 'pt' ? 'Acesso' : 'Access'}</p>
    <h2>{p.resetTitle}</h2>
    <span class="gold-rule"></span>
    <p class="note">{p.resetText}</p>
    <form class="access-form" data-reset novalidate>
      <fieldset>
        <label><span>{p.email}</span><input type="email" name="email" autocomplete="username" required /></label>
        <button type="submit" class="btn btn--primary">{p.resetSubmit}</button>
        <button type="button" class="forgot" data-go="login">{p.backToLogin}</button>
      </fieldset>
      <p class="msg" role="status" aria-live="polite" hidden data-reset-msg></p>
    </form>
  </div>

  <!-- Criar / redefinir senha (link do convite ou do e-mail de recuperação) -->
  <div class="access-card" data-view="senha" hidden>
    <p class="eyebrow eyebrow--gold">{lang === 'pt' ? 'Acesso' : 'Access'}</p>
    <h2 data-senha-titulo>{p.setPwReset}</h2>
    <span class="gold-rule"></span>
    <p class="note">{p.pwRules}</p>
    <form class="access-form" data-senha novalidate>
      <fieldset>
        <label><span>{p.newPassword}</span><input type="password" name="senha" autocomplete="new-password" required minlength="10" /></label>
        <label><span>{p.confirmPassword}</span><input type="password" name="confirma" autocomplete="new-password" required minlength="10" /></label>
        <button type="submit" class="btn btn--primary">{p.savePassword}</button>
        <button type="button" class="forgot" data-go="login">{p.backToLogin}</button>
      </fieldset>
      <p class="msg" role="status" aria-live="polite" hidden data-senha-msg></p>
    </form>
  </div>

  <!-- Carregando (nenhum dado é mostrado antes de pertencer à sessão atual) -->
  <div class="access-card loading" data-view="loading" hidden>
    <p class="eyebrow eyebrow--gold">{lang === 'pt' ? 'Área do Cliente' : 'Client Area'}</p>
    <p class="loading__txt" role="status" aria-live="polite">{p.loading}</p>
  </div>

  <!-- Painel (somente dados do cliente autenticado) -->
  <div class="dash" data-view="dash" hidden>
    <header class="dash__head">
      <div>
        <p class="eyebrow eyebrow--gold">{lang === 'pt' ? 'Área do Cliente' : 'Client Area'}</p>
        <h2>{p.hello}, <span data-name></span></h2>
        <p class="dash__email" data-email></p>
      </div>
      <button type="button" class="btn btn--secondary btn--sm" data-signout>{p.signOut}</button>
    </header>

    <nav class="tabs" role="tablist">
      <button role="tab" aria-selected="true" data-tab="profile">{p.tabs.profile}</button>
      <button role="tab" aria-selected="false" data-tab="documents">{p.tabs.documents}</button>
      <button role="tab" aria-selected="false" data-tab="appointments">{p.tabs.appointments}</button>
    </nav>

    <section data-panel="profile">
      <form data-profile novalidate>
        <h3>{p.profileTitle}</h3>
        <div class="grid">
          <label class="ro"><span>{p.emailLabel}</span><input type="text" data-ro="email" readonly /></label>
          {profileFields.map((f) => <label><span>{p.fields[f]}</span><input type="text" name={f} maxlength="200" /></label>)}
        </div>
        <h3>{p.passport}</h3>
        <div class="grid">
          <label><span>{p.passportNumber}</span><input type="text" name="passportnumber" data-pass="numero" maxlength="24" autocomplete="off" autocapitalize="characters" spellcheck="false" /></label>
          <label><span>{p.passportExpiry}</span><input type="date" name="passportexpirationdate" data-pass="validade" min="2000-01-01" max="2100-12-31" /></label>
        </div>
        <p class="note pass-locked" data-pass-locked hidden></p>
        <div data-company hidden>
          <h3>{p.companyTitle}</h3>
          <div class="grid">
            {companyFields.map((f) => <label><span>{p.fields[f]}</span><input type="text" name={f} maxlength="200" /></label>)}
          </div>
        </div>
        <p class="note">{p.readOnlyNote}</p>
        <button type="submit" class="btn btn--primary" data-save>{p.save}</button>
        <p class="msg" role="status" aria-live="polite" hidden data-profile-msg></p>
      </form>
    </section>

    <section data-panel="documents" hidden>
      <h3>{p.docsTitle}</h3>
      <p class="note">{p.docsText}</p>
      <label class="btn btn--primary upload">
        <span data-upload-label>{p.upload}</span>
        <input type="file" accept="application/pdf,image/jpeg,image/png" data-upload hidden />
      </label>
      <p class="msg" role="status" aria-live="polite" hidden data-docs-msg></p>
      <ul class="list" data-docs></ul>
    </section>

    <section data-panel="appointments" hidden>
      <h3>{p.apptTitle}</h3>
      <button type="button" class="btn btn--primary" data-appt-open>{p.apptNew}</button>
      <form class="appt-form" data-appt-form novalidate hidden>
        <h4>{p.apptFormTitle}</h4>
        <div class="grid">
          <label><span>{p.apptSubject}</span>
            <select name="assunto" required>
              {Object.entries(p.assuntos).map(([k, v]) => <option value={k}>{v}</option>)}
            </select>
          </label>
          <label><span>{p.apptDate}</span><input type="date" name="data" required data-appt-date /></label>
        </div>
        <fieldset class="chips">
          <legend>{p.apptFormat}</legend>
          {Object.entries(p.formatos).map(([k, v]) => <label class="chip"><input type="radio" name="formato" value={k} required /><span>{v}</span></label>)}
        </fieldset>
        <fieldset class="chips">
          <legend>{p.apptPeriod}</legend>
          {Object.entries(p.periodos).map(([k, v]) => <label class="chip"><input type="radio" name="periodo" value={k} required /><span>{v}</span></label>)}
        </fieldset>
        <label class="full"><span>{p.apptNotes}</span><textarea name="observacao" maxlength="500" rows="3" placeholder={p.apptNotesPh}></textarea></label>
        <div class="appt-actions">
          <button type="submit" class="btn btn--primary" data-appt-send>{p.apptSend}</button>
          <button type="button" class="link" data-appt-cancel>{p.apptCancel}</button>
        </div>
      </form>
      <p class="msg" role="status" aria-live="polite" hidden data-appt-msg></p>
      <ul class="list" data-appts></ul>
      <p class="note">{p.apptText} <a href={routes.contact[lang]}>{p.contact}</a></p>
    </section>
  </div>
</div>

<script>
  // Área do Cliente: API do próprio site no Railway. Sessão em cookie HttpOnly (o JavaScript não lê o cookie).
  const PROFILE = ['display_name', 'phone_number', 'nationality', 'dateofbirth', 'address', 'residencenumber', 'city', 'country', 'zipcode'];
  const COMPANY = ['CompanyName', 'Companyregistrationnumber', 'companysadress', 'companyaddressnumber', 'companycity', 'companycountry', 'companyzipcode'];
  const TYPES = ['application/pdf', 'image/jpeg', 'image/png'];
  const MAX = 10 * 1024 * 1024;

  function boot() {
    const root = document.querySelector<HTMLElement>('[data-portal]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const M = JSON.parse(root.dataset.msg!);
    const lang = root.dataset.lang;
    const locale = lang === 'en' ? 'en-GB' : 'pt-BR';
    const API = '/api/cliente';
    const api = (rota: string, opts: RequestInit = {}) => fetch(API + rota, { credentials: 'same-origin', ...opts });
    const enviarJson = (rota: string, metodo: string, corpo: unknown) => api(rota, { method: metodo, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(corpo) });

    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const views = root.querySelectorAll<HTMLElement>('[data-view]');
    const show = (v: string) => views.forEach((el) => (el.hidden = el.dataset.view !== v));
    const msg = (el: HTMLElement, text: string, kind: 'ok' | 'err' = 'ok') => { el.hidden = false; el.textContent = text; el.dataset.kind = kind; };
    const limparMsg = (el: HTMLElement) => { el.hidden = true; el.textContent = ''; delete el.dataset.kind; };
    root.querySelectorAll<HTMLElement>('[data-go]').forEach((b) => b.addEventListener('click', () => { history.replaceState(null, '', location.pathname); show(b.dataset.go!); }));

    // ---- Sessão: cada entrada/saída cria uma nova sessão de tela; respostas de sessões anteriores são descartadas
    let sessao = 0;
    let usuarioAtual: string | null = null;
    let original: Record<string, string> = {};
    const vigente = (s: number, email: string) => s === sessao && usuarioAtual === email;
    const upInput = $<HTMLInputElement>('[data-upload]'); const upLabel = $('[data-upload-label]');
    const profileForm = $<HTMLFormElement>('[data-profile]'); const saveBtn = $<HTMLButtonElement>('[data-save]');
    const passNum = $<HTMLInputElement>('[data-pass="numero"]'); const passVal = $<HTMLInputElement>('[data-pass="validade"]');
    const apptForm = $<HTMLFormElement>('[data-appt-form]'); const apptOpen = $<HTMLButtonElement>('[data-appt-open]');

    function limparTudo() {
      original = {};
      $('[data-name]').textContent = ''; $('[data-email]').textContent = '';
      root.querySelectorAll<HTMLInputElement>('[data-profile] input').forEach((i) => (i.value = ''));
      $('[data-company]').hidden = true;
      $('[data-docs]').innerHTML = ''; $('[data-appts]').innerHTML = '';
      ['[data-profile-msg]', '[data-docs-msg]', '[data-appt-msg]'].forEach((k) => limparMsg($(k)));
      apptForm.reset(); apptForm.hidden = true; apptOpen.hidden = false;
      passNum.readOnly = false; passVal.readOnly = false; passNum.placeholder = ''; $('[data-pass-locked]').hidden = true;
      upInput.value = ''; upLabel.textContent = M.upload; saveBtn.disabled = false; saveBtn.textContent = M.save;
      root.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((x) => x.setAttribute('aria-selected', String(x.dataset.tab === 'profile')));
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== 'profile'));
    }

    // ---- Login
    const loginForm = $<HTMLFormElement>('[data-login]'); const loginBtn = $<HTMLButtonElement>('[data-login-btn]');
    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(loginForm); const lm = $('[data-login-msg]'); limparMsg(lm);
      loginBtn.disabled = true; loginBtn.textContent = M.signingIn;
      try {
        const r = await enviarJson('/entrar', 'POST', { email: String(f.get('email')).trim(), senha: String(f.get('password')) });
        if (r.ok) { loginForm.reset(); await abrirSessao(); }
        else msg(lm, r.status === 429 ? M.tooMany : r.status === 401 ? M.loginError : M.genericError, 'err');
      } catch { msg(lm, M.genericError, 'err'); }
      finally { loginBtn.disabled = false; loginBtn.textContent = M.submit; }
    });

    // ---- Esqueci a senha (mesma mensagem exista ou não a conta)
    const resetForm = $<HTMLFormElement>('[data-reset]');
    resetForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = String(new FormData(resetForm).get('email')).trim(); const rm = $('[data-reset-msg]');
      try { await enviarJson('/esqueci', 'POST', { email, lang }); msg(rm, M.resetSent); } catch { msg(rm, M.genericError, 'err'); }
    });

    // ---- Criar/redefinir senha (token do link no endereço; removido da barra assim que lido)
    const params = new URLSearchParams(location.search);
    const tokenSenha = params.get('convite') || params.get('redefinir');
    if (tokenSenha) {
      history.replaceState(null, '', location.pathname);
      $('[data-senha-titulo]').textContent = params.get('convite') ? M.setPwInvite : M.setPwReset;
    }
    const senhaForm = $<HTMLFormElement>('[data-senha]');
    senhaForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(senhaForm); const sm = $('[data-senha-msg]'); limparMsg(sm);
      const senha = String(f.get('senha')), confirma = String(f.get('confirma'));
      if (senha !== confirma) return msg(sm, M.pwMismatch, 'err');
      try {
        const r = await enviarJson('/redefinir', 'POST', { token: tokenSenha, senha });
        const d = await r.json().catch(() => ({}));
        if (r.ok) { senhaForm.reset(); await abrirSessao(); return; }
        msg(sm, d.erro === 'link_invalido' ? M.linkInvalid : (M.pwErr[d.erro] || M.genericError), 'err');
      } catch { msg(sm, M.genericError, 'err'); }
    });

    $('[data-signout]').addEventListener('click', async () => {
      sessao++; usuarioAtual = null; limparTudo(); show('login');
      await api('/sair', { method: 'POST' }).catch(() => {});
    });

    // ---- Abas
    root.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => b.addEventListener('click', () => {
      root.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== b.dataset.tab));
    }));
    // sessão encerrada no servidor (expirada/revogada): volta ao login
    const sessaoCaiu = () => { sessao++; usuarioAtual = null; limparTudo(); show('login'); msg($('[data-login-msg]'), M.sessionEnded, 'err'); };

    // ---- Perfil
    function mostrarPerfil(d: Record<string, any>, email: string) {
      const p = d.perfil || {};
      $('[data-name]').textContent = p.display_name || email;
      $('[data-email]').textContent = email;
      $<HTMLInputElement>('[data-ro="email"]').value = email;
      original = {};
      // passaporte: o número completo nunca vem do servidor (só os 3 últimos); conferido pela equipe = travado
      const travado = Boolean(p.passaporteConferidoEm);
      passNum.value = travado ? (p.passaporte || '') : '';
      passNum.placeholder = !travado && p.passaporte ? p.passaporte : '';
      passVal.value = p.passaporteValidade || ''; original.passportexpirationdate = passVal.value;
      passNum.readOnly = travado; passVal.readOnly = travado;
      const aviso = $('[data-pass-locked]'); aviso.hidden = !(travado || p.passaporte); aviso.dataset.travado = String(travado);
      aviso.textContent = M.passportKeep;
      if (travado) aviso.textContent = M.passportLocked.replace('{data}', new Date(p.passaporteConferidoEm).toLocaleDateString(locale, { day: 'numeric', month: 'short', year: 'numeric' }));
      for (const k of [...PROFILE, ...COMPANY]) {
        const v = typeof p[k] === 'string' ? p[k] : '';
        original[k] = v;
        const input = root.querySelector<HTMLInputElement>(`[data-profile] [name="${k}"]`); if (input) input.value = v;
      }
      $('[data-company]').hidden = !COMPANY.some((k) => original[k]);
    }
    profileForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!usuarioAtual) return;
      const s = sessao, email = usuarioAtual;
      const pm = $('[data-profile-msg]'); const changes: Record<string, string> = {};
      for (const k of [...PROFILE, ...COMPANY]) {
        const input = profileForm.querySelector<HTMLInputElement>(`[name="${k}"]`); if (!input) continue;
        const v = input.value.trim().slice(0, 200);
        if (v !== original[k]) changes[k] = v;
      }
      if (!passNum.readOnly) {
        const n = passNum.value.replace(/[\s-]/g, '').toUpperCase();
        if (n) { if (!/^[A-Z0-9]{5,20}$/.test(n)) return msg(pm, M.passportBad, 'err'); changes.passportnumber = n; }
        if (passVal.value !== original.passportexpirationdate) changes.passportexpirationdate = passVal.value;
      }
      if (!Object.keys(changes).length) return msg(pm, M.nothingChanged);
      saveBtn.disabled = true; saveBtn.textContent = M.saving;
      try {
        const r = await enviarJson('/perfil', 'PUT', changes);
        if (!vigente(s, email)) return;
        if (r.status === 401) return sessaoCaiu();
        if (r.status === 409 || r.status === 400) {
          const d = await r.json().catch(() => ({}));
          if (!vigente(s, email)) return;
          if (d.erro === 'passaporte_conferido') return msg(pm, M.passportLockedErr, 'err');
          if (d.campo === 'passportnumber') return msg(pm, M.passportBad, 'err');
          if (d.campo === 'passportexpirationdate') return msg(pm, M.passportBadDate, 'err');
          throw new Error();
        }
        if (!r.ok) throw new Error();
        const novo = await r.json().catch(() => null);
        if (!vigente(s, email)) return;
        if (novo && novo.perfil) mostrarPerfil(novo, email); else Object.assign(original, changes);
        msg(pm, M.saved); if (changes.display_name) $('[data-name]').textContent = changes.display_name;
      } catch { if (vigente(s, email)) msg(pm, M.genericError, 'err'); }
      finally { if (vigente(s, email)) { saveBtn.disabled = false; saveBtn.textContent = M.save; } }
    });

    // ---- Documentos (estado definido pelo servidor; download pelo servidor, sem link)
    const fmtSize = (n: number) => (n > 1048576 ? (n / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(n / 1024)) + ' KB');
    const fmtDate = (d: Date) => d.toLocaleDateString(locale, { day: 'numeric', month: 'short', year: 'numeric' });
    async function baixar(d: any, s: number, email: string) {
      const dm = $('[data-docs-msg]');
      try {
        const r = await api(`/documentos/${encodeURIComponent(d.id)}/arquivo`);
        if (!vigente(s, email)) return;
        if (r.status === 401) return sessaoCaiu();
        if (!r.ok) throw new Error(String(r.status));
        const blob = await r.blob();
        if (!vigente(s, email)) return;
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a'); a.href = url; a.download = d.nome; a.click(); setTimeout(() => URL.revokeObjectURL(url), 5000);
      } catch { if (vigente(s, email)) msg(dm, M.genericError, 'err'); }
    }
    function renderDocs(lista: any[], s: number, email: string) {
      const ul = $('[data-docs]'); ul.innerHTML = '';
      if (!lista.length) { const li = document.createElement('li'); li.className = 'empty'; li.textContent = M.docsEmpty; ul.append(li); return; }
      for (const d of lista) {
        const li = document.createElement('li'); li.dataset.status = d.status;
        const name = document.createElement('span'); name.className = 'name'; name.textContent = d.nome;
        const info = document.createElement('span'); info.className = 'info';
        info.textContent = [d.recebidoEm ? fmtDate(new Date(d.recebidoEm)) : '', d.tamanho ? fmtSize(d.tamanho) : ''].filter(Boolean).join(' · ');
        const badge = document.createElement('span'); badge.className = 'badge'; badge.dataset.status = d.status; badge.textContent = M.st[d.status] ?? d.status;
        li.append(name, info, badge);
        if (d.baixavel) {
          const btn = document.createElement('button'); btn.type = 'button'; btn.className = 'link'; btn.textContent = M.download;
          btn.addEventListener('click', () => baixar(d, s, email));
          li.append(btn);
        } else { li.append(document.createElement('span')); }
        if (d.status === 'rejeitado' && d.orientacao) { const o = document.createElement('p'); o.className = 'orient'; o.textContent = `${d.orientacao[lang === 'en' ? 'en' : 'pt'] || d.orientacao.pt} ${M.resendHint}`; li.append(o); }
        ul.append(li);
      }
    }
    const lerDocs = async () => { const r = await api('/documentos'); if (r.status === 401) throw Object.assign(new Error(), { sessao: true }); if (!r.ok) throw new Error(); return (await r.json()).documentos; };
    upInput.addEventListener('change', async () => {
      const file = upInput.files?.[0]; const dm = $('[data-docs-msg]'); upInput.value = '';
      if (!usuarioAtual || !file) return;
      const s = sessao, email = usuarioAtual;
      if (!TYPES.includes(file.type)) return msg(dm, M.badType, 'err');
      if (file.size > MAX) return msg(dm, M.tooBig, 'err');
      upLabel.textContent = M.uploading;
      try {
        const r = await api('/documentos', { method: 'POST', headers: { 'Content-Type': file.type, 'X-Nome-Arquivo': encodeURIComponent(file.name) }, body: file });
        if (!vigente(s, email)) return;
        if (r.status === 401) return sessaoCaiu();
        const lista = await lerDocs();
        if (!vigente(s, email)) return;
        renderDocs(lista, s, email);
        if (r.status === 201) msg(dm, M.uploaded);
        else if (r.status === 422) msg(dm, M.st.rejeitado + ' — ' + M.resendHint, 'err');
        else msg(dm, r.status === 413 ? M.tooBig : r.status === 415 ? M.badType : r.status === 429 ? M.quota : M.genericError, 'err');
      } catch { if (vigente(s, email)) msg(dm, M.genericError, 'err'); }
      finally { if (vigente(s, email)) upLabel.textContent = M.upload; }
    });

    // ---- Agendamentos: data SOLICITADA (data civil, sem horário) x horário CONFIRMADO pela equipe
    const dataCivil = (s: string) => { const [y, m, d] = s.split('-').map(Number); return new Date(Date.UTC(y, m - 1, d)).toLocaleDateString(locale, { timeZone: 'UTC', day: 'numeric', month: 'short', year: 'numeric' }); };
    function mostrarAgendamentos(lista: any[]) {
      const ul = $('[data-appts]'); ul.innerHTML = '';
      if (!lista.length) { const li = document.createElement('li'); li.className = 'empty'; li.textContent = M.apptEmpty; ul.append(li); return; }
      for (const a of lista) {
        const li = document.createElement('li'); li.className = 'appt';
        const n = document.createElement('span'); n.className = 'name'; n.textContent = M.assuntos[a.tipo] || a.tipo || '—';
        const i = document.createElement('span'); i.className = 'info';
        if (a.horarioConfirmado) {
          i.textContent = `${M.apptConfirmed}: ${new Date(a.horarioConfirmado).toLocaleString(locale, { timeZone: 'Asia/Dubai', dateStyle: 'medium', timeStyle: 'short' })} · ${M.tz}`;
          li.dataset.tipo = 'confirmado';
        } else if (a.dataSolicitada) {
          i.textContent = `${M.apptRequested}: ${dataCivil(a.dataSolicitada)} · ${M.apptToConfirm}`;
          li.dataset.tipo = 'solicitado';
        } else {
          i.textContent = M.apptPending; li.dataset.tipo = 'pendente';
        }
        li.append(n, i);
        const extra = [M.formatos[a.formato], M.periodos[a.periodo], a.descricao].filter(Boolean).join(' · ');
        if (extra) { const o = document.createElement('p'); o.className = 'orient orient--info'; o.textContent = extra; li.append(o); }
        ul.append(li);
      }
    }

    // ---- Pedido de agendamento (a equipe confirma o horário depois)
    const somarDias = (n: number) => { const d = new Date(Date.now() + 4 * 3600 * 1000); d.setUTCDate(d.getUTCDate() + n); return d.toISOString().slice(0, 10); };
    apptOpen.addEventListener('click', () => {
      const dt = $<HTMLInputElement>('[data-appt-date]'); dt.min = somarDias(1); dt.max = somarDias(180);
      apptForm.hidden = false; apptOpen.hidden = true; limparMsg($('[data-appt-msg]'));
      apptForm.querySelector<HTMLSelectElement>('select')?.focus();
    });
    $('[data-appt-cancel]').addEventListener('click', () => { apptForm.reset(); apptForm.hidden = true; apptOpen.hidden = false; });
    const apptSend = $<HTMLButtonElement>('[data-appt-send]');
    apptForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!usuarioAtual) return;
      const s = sessao, email = usuarioAtual; const am = $('[data-appt-msg]'); limparMsg(am);
      const f = new FormData(apptForm); const data = String(f.get('data') || '');
      const dt = $<HTMLInputElement>('[data-appt-date]');
      if (!data || data < dt.min || data > dt.max) return msg(am, M.apptBadDate, 'err');
      if (!f.get('formato') || !f.get('periodo')) return msg(am, M.apptChoose, 'err');
      apptSend.disabled = true; apptSend.textContent = M.apptSending;
      try {
        const r = await enviarJson('/agendamentos', 'POST', { assunto: f.get('assunto'), data, formato: f.get('formato'), periodo: f.get('periodo'), observacao: String(f.get('observacao') || '').trim() });
        if (!vigente(s, email)) return;
        if (r.status === 401) return sessaoCaiu();
        if (r.status === 429) return msg(am, M.apptLimit, 'err');
        if (r.status === 400) { const d = await r.json().catch(() => ({})); return msg(am, d.erro === 'data_invalida' ? M.apptBadDate : M.genericError, 'err'); }
        if (!r.ok) throw new Error();
        apptForm.reset(); apptForm.hidden = true; apptOpen.hidden = false;
        const l = await api('/agendamentos').then((x) => (x.ok ? x.json() : null));
        if (!vigente(s, email)) return;
        if (l) mostrarAgendamentos(l.agendamentos);
        msg(am, M.apptSent);
      } catch { if (vigente(s, email)) msg(am, M.genericError, 'err'); }
      finally { if (vigente(s, email)) { apptSend.disabled = false; apptSend.textContent = M.apptSend; } }
    });

    // ---- Abrir sessão: limpa tudo, mostra "carregando" e só exibe dados que pertencem à sessão atual
    async function abrirSessao() {
      const s = ++sessao;
      usuarioAtual = null; limparTudo();
      show('loading');
      const r = await api('/sessao').catch(() => null);
      if (s !== sessao) return;
      if (!r || !r.ok) { show(tokenSenha ? 'senha' : 'login'); return; }
      const { email } = await r.json();
      if (s !== sessao) return;
      usuarioAtual = email;
      const [perfil, docs, agend] = await Promise.allSettled([
        api('/perfil').then((x) => (x.ok ? x.json() : Promise.reject(x.status))),
        lerDocs(),
        api('/agendamentos').then((x) => (x.ok ? x.json() : Promise.reject(x.status))),
      ]);
      if (!vigente(s, email)) return;                       // resposta de sessão anterior: descartada
      if ([perfil, docs, agend].some((x) => x.status === 'rejected' && ((x as PromiseRejectedResult).reason === 401 || (x as any).reason?.sessao))) return sessaoCaiu();
      if (perfil.status === 'fulfilled') mostrarPerfil(perfil.value, email); else { $('[data-email]').textContent = email; msg($('[data-profile-msg]'), M.genericError, 'err'); }
      if (docs.status === 'fulfilled') renderDocs(docs.value, s, email); else msg($('[data-docs-msg]'), M.genericError, 'err');
      mostrarAgendamentos(agend.status === 'fulfilled' ? agend.value.agendamentos : []);
      show('dash');
      requestAnimationFrame(() => root.scrollIntoView({ behavior: 'smooth', block: 'start' }));
    }

    // ---- Início: a área só funciona se o servidor estiver configurado (banco + volume)
    (async () => {
      let ativo = false;
      try { ativo = (await (await api('/status')).json()).ativo === true; } catch { /* indisponível */ }
      $('[data-indisponivel]').hidden = ativo;
      $<HTMLFieldSetElement>('[data-login-fs]').disabled = !ativo;
      if (!ativo) { show('login'); return; }
      if (tokenSenha) {
        // chegou pelo link do e-mail: leva direto ao quadro de criar senha
        show('senha');
        requestAnimationFrame(() => { root.scrollIntoView({ behavior: 'smooth', block: 'start' }); senhaForm.querySelector<HTMLInputElement>('input')?.focus({ preventScroll: true }); });
        return;
      }
      await abrirSessao();
    })();
  }
  document.addEventListener('astro:page-load', boot);
</script>

