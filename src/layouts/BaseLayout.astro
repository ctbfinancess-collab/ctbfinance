---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations, routes, getRouteKey } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  /** Cabeçalho transparente sobre a imagem de abertura */
  overlayHeader?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title = t('site.title'), description = t('site.description'), overlayHeader = false } = Astro.props;
const site = Astro.site ?? new URL('https://ctbfinances.ae');
const key = getRouteKey(Astro.url);
const canonical = new URL(Astro.url.pathname, site).href;
const alt = { pt: new URL(routes[key].pt, site).href, en: new URL(routes[key].en, site).href };
const ogImage = new URL('/brand/ctb-logo.jpg', site).href;
---
<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#35241D" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={alt.pt} />
    <link rel="alternate" hreflang="en" href={alt.en} />
    <link rel="alternate" hreflang="x-default" href={alt.pt} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CTB Finances Dubai" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header overlay={overlayHeader} />
    <main><slot /></main>
    <Footer />
  </body>
</html>
